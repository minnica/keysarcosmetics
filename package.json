{
  "name": "cosmetics-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ui": "pnpm --filter @cosmetics/ui test:ui",
    "test:ui:coverage": "pnpm --filter @cosmetics/ui test:ui:coverage",
    "test:ui:visual": "pnpm --filter @cosmetics/ui-testbed build && pnpm --filter @cosmetics/e2e test:ui:visual",
    "test:ui:visual:update": "pnpm --filter @cosmetics/ui-testbed build && pnpm --filter @cosmetics/e2e test:ui:visual:update",
    "test:unit": "pnpm --filter @cosmetics/api test:unit",
    "test:integration": "pnpm --filter @cosmetics/api test:integration",
    "test:smoke": "pnpm --filter @cosmetics/e2e test:smoke",
    "test:e2e:development": "pnpm --filter @cosmetics/e2e test:development",
    "test:e2e:production": "pnpm --filter @cosmetics/e2e test:production",
    "turbo:graph:verify": "node scripts/verify-turbo-graph.mjs",
    "deploy:impact": "node scripts/detect-vercel-impact.mjs",
    "deploy:impact:test": "node scripts/vercel-impact-detector.test.mjs",
    "deploy:impact:history": "node scripts/run-vercel-impact-history.mjs",
    "deploy:pilot:test": "node scripts/vercel-pilot-deployment.test.mjs",
    "deploy:development:test": "node scripts/vercel-development-config.test.mjs",
    "deploy:production-shadow:test": "node scripts/vercel-production-shadow.test.mjs",
    "deploy:release-manifest:test": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON apps/e2e/helpers/release-identity.test.ts",
    "migrations:review": "node scripts/check-migration-safety.mjs",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check:all": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "ci:quality": "pnpm lint && pnpm type-check && pnpm test:unit",
    "ci:build": "pnpm --filter @cosmetics/api --filter @cosmetics/landing --filter @cosmetics/envelope --filter @cosmetics/payroll --filter @cosmetics/crm --filter @cosmetics/scheduler --filter @cosmetics/finance --filter @cosmetics/hr build && pnpm --filter @cosmetics/pos build:web"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "7.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "supabase": "^2.110.0",
    "turbo": "2.10.5",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
