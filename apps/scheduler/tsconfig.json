{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@scheduler/runtime": ["./src/lib/runtime.tsx"],
      "@scheduler/design-proposals": ["./src/lib/design-proposals.ts"],
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-design/types/**/*.ts",
    ".next-design-dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
