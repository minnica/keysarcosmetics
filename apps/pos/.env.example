# Configuración pública del renderer. En Windows/RV10-P4 se recomienda definirla
# en la sesión de PowerShell según docs/POS_WINDOWS_API_DEMO.md.
VITE_API_URL=http://127.0.0.1:4000
VITE_POS_DATA_MODE=api

# Configuración privada del proceso principal. Los valores reales se reciben por
# canal privado y no se copian a este archivo, al renderer ni al repositorio.
POS_API_URL=http://127.0.0.1:4000
POS_TERMINAL_CODE=<capturar-en-la-sesion-privada>
POS_TERMINAL_SECRET=<capturar-en-la-sesion-privada>
