{
  "name": "@cosmetics/e2e",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint \"**/*.ts\" --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:development": "playwright test -c playwright.development.config.ts",
    "test:development:headed": "playwright test -c playwright.development.config.ts --headed",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:production:headed": "playwright test -c playwright.production.config.ts --headed",
    "test:ui:visual": "playwright test -c playwright.visual.config.ts",
    "test:ui:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1"
  }
}
