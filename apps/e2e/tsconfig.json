{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.development.config.ts",
    "playwright.production.config.ts",
    "helpers/**/*.ts",
    "tests/**/*.ts",
    "development/**/*.ts",
    "production/**/*.ts"
  ]
}
