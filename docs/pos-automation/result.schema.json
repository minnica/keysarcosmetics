{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "outcome",
    "summary",
    "checks",
    "remaining",
    "nextStep"
  ],
  "properties": {
    "taskId": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": ["completed", "partial", "blocked"]
    },
    "summary": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "evidence"],
        "properties": {
          "command": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "failed_unrelated", "not_run"]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "remaining": {
      "description": "Trabajo todavía faltante dentro del criterio asignado. Debe ser [] cuando outcome es completed; seguimientos externos van en informe y nextStep.",
      "type": "array",
      "items": { "type": "string" }
    },
    "nextStep": { "type": "string" }
  }
}
