generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  SUPER_ADMIN
  GERENTE
  CAPTURISTA
}

enum PosTerminalStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Usuario {
  id                                      String                            @id @default(cuid())
  nombre                                  String
  email                                   String                            @unique
  passwordHash                            String
  rol                                     Rol
  activo                                  Boolean                           @default(true)
  sucursalId                              String?
  sucursal                                Sucursal?                         @relation(fields: [sucursalId], references: [id])
  empleadoId                              String?                           @unique
  empleado                                Empleado?                         @relation(fields: [empleadoId], references: [id])
  registrosCitaCreados                    RegistroCita[]
  passwordChangedAt                       DateTime?
  passwordSetupTokenHash                  String?
  passwordSetupTokenExpiresAt             DateTime?
  creadoEn                                DateTime                          @default(now())
  actualizadoEn                           DateTime                          @updatedAt
  payrollRunsCreated                      PayrollRun[]                      @relation("PayrollRunCreatedBy")
  payrollRunsApproved                     PayrollRun[]                      @relation("PayrollRunApprovedBy")
  payrollRunsPaid                         PayrollRun[]                      @relation("PayrollRunPaidBy")
  payrollCatalogItemsCreated              PayrollCatalogItem[]              @relation("PayrollCatalogItemCreatedBy")
  payrollSchemeVersionsCreated            CommissionSchemeVersion[]         @relation("CommissionSchemeVersionCreatedBy")
  payrollAssignmentsCreated               EmployeeCommissionAssignment[]    @relation("EmployeeCommissionAssignmentCreatedBy")
  payrollMovementsCreated                 PayrollMovement[]                 @relation("PayrollMovementCreatedBy")
  payrollMovementsReviewed                PayrollMovement[]                 @relation("PayrollMovementReviewedBy")
  payrollExpensesCreated                  PayrollExpense[]                  @relation("PayrollExpenseCreatedBy")
  payrollExpenseRecurrencesCreated        PayrollExpenseRecurrence[]        @relation("PayrollExpenseRecurrenceCreatedBy")
  payrollExpenseRecurrenceVersionsCreated PayrollExpenseRecurrenceVersion[] @relation("PayrollExpenseRecurrenceVersionCreatedBy")
  payrollExpenseCategoriesCreated         PayrollExpenseCategory[]          @relation("PayrollExpenseCategoryCreatedBy")
  payrollLoansCreated                     LoanAdvance[]                     @relation("LoanAdvanceCreatedBy")
  payrollReceiptsSent                     PayrollReceipt[]                  @relation("PayrollReceiptSentBy")
  payrollReceiptsConfirmed                PayrollReceipt[]                  @relation("PayrollReceiptConfirmedBy")
  payrollAuditEvents                      PayrollAuditEvent[]
  posCredentials                          PosCredential[]
}

model Sucursal {
  id                               String                            @id @default(cuid())
  nombre                           String
  metaMensual                      Decimal                           @default(0) @db.Decimal(14, 2)
  activa                           Boolean                           @default(true)
  desactivadaEn                    DateTime?
  usuarios                         Usuario[]
  empleados                        Empleado[]
  ventas                           Venta[]
  registrosCita                    RegistroCita[]
  creadoEn                         DateTime                          @default(now())
  actualizadoEn                    DateTime                          @updatedAt
  payrollMovementAllocations       PayrollMovementAllocation[]
  payrollExpenses                  PayrollExpense[]
  payrollExpenseRecurrenceVersions PayrollExpenseRecurrenceVersion[]
  payrollRunBranchLines            PayrollRunBranchLine[]
  posProfile                       PosBranchProfile?
  posTerminals                     PosTerminal[]
  posAuditLogs                     AuditLog[]
  catalogVisibility                CatalogItemBranchVisibility[]
  customerPortfolios               CustomerPortfolioAssignment[]
  priceListAssignments             PriceListBranchAssignment[]
  salesCompetitions                PosSalesCompetition[]
  inventoryLocations               InventoryLocation[]
  warehouseRequests                WarehouseRequest[]
  posNotifications                 PosNotification[]

  @@index([activa])
}

model CategoriaAtencion {
  id            String                 @id @default(cuid())
  nombre        String                 @unique
  activa        Boolean                @default(true)
  subcategorias SubcategoriaAtencion[]
  creadoEn      DateTime               @default(now())
  actualizadoEn DateTime               @updatedAt
}

model SubcategoriaAtencion {
  id            String            @id @default(cuid())
  nombre        String
  activa        Boolean           @default(true)
  categoriaId   String
  categoria     CategoriaAtencion @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  registrosCita RegistroCita[]
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  @@unique([categoriaId, nombre])
  @@index([categoriaId, activa])
}

// ─── Módulo Envelope ──────────────────────────────────────────────────────────

enum MetodoPagoTipo {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

model MetodoPago {
  id            String                  @id @default(cuid())
  nombre        String
  tipo          MetodoPagoTipo
  activo        Boolean                 @default(true)
  detalles      VentaDetalle[]
  creadoEn      DateTime                @default(now())
  actualizadoEn DateTime                @updatedAt
  posPolicy     PosPaymentMethodPolicy?
}

model Bank {
  id            String     @id @default(cuid())
  nombre        String     @unique
  activo        Boolean    @default(true)
  empleados     Empleado[]
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
}

model Position {
  id                       String                            @id @default(cuid())
  nombre                   String                            @unique
  activo                   Boolean                           @default(true)
  canManageAccess          Boolean                           @default(false)
  canManagePayrollAccess   Boolean                           @default(false)
  selfDataOnly             Boolean                           @default(false)
  empleados                Empleado[]
  screenPermissions        PositionScreenPermission[]
  payrollScreenPermissions PositionPayrollScreenPermission[]
  posPermissions           PositionPosPermission[]
  creadoEn                 DateTime                          @default(now())
  actualizadoEn            DateTime                          @updatedAt
}

model PositionScreenPermission {
  id            String   @id @default(cuid())
  positionId    String
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  screenKey     String
  allowed       Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([positionId, screenKey])
}

model PositionPayrollScreenPermission {
  id            String   @id @default(cuid())
  positionId    String
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  screenKey     String
  allowed       Boolean  @default(true)
  canWrite      Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([positionId, screenKey])
}

enum ProtectedEmployeeKey {
  KEYSAR_HOME
}

model ProtectedEmployeeIdentity {
  key           ProtectedEmployeeKey @id
  employeeId    String               @unique
  employee      Empleado             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
}

model Empleado {
  id                         String                         @id @default(cuid())
  nombres                    String
  apellidoPaterno            String
  apellidoMaterno            String
  nombreCompleto             String
  // Campos legacy — se eliminan en Fase 4 tras backfill completo en producción
  banco                      String
  numeroCuenta               String
  puesto                     String
  sueldo                     Decimal?                       @db.Decimal(10, 2)
  fechaNacimiento            DateTime?
  numeroTelefono             String?
  // FK a catálogos dinámicos — nullable durante transición
  bankId                     String?
  bank                       Bank?                          @relation(fields: [bankId], references: [id])
  positionId                 String?
  position                   Position?                      @relation(fields: [positionId], references: [id])
  sucursalId                 String?
  sucursal                   Sucursal?                      @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  todasSucursales            Boolean                        @default(false)
  usuario                    Usuario?
  metaIndividual             Decimal                        @db.Decimal(10, 2)
  activo                     Boolean                        @default(true)
  ventas                     Venta[]
  citasComoVendedor          RegistroCita[]                 @relation("RegistroCitaVendedor")
  citasComoFacialista        RegistroCita[]                 @relation("RegistroCitaFacialista")
  creadoEn                   DateTime                       @default(now())
  actualizadoEn              DateTime                       @updatedAt
  payrollAssignments         EmployeeCommissionAssignment[]
  payrollMovementAllocations PayrollMovementAllocation[]
  payrollLoans               LoanAdvance[]
  payrollRunLines            PayrollRunLine[]
  protectedIdentity          ProtectedEmployeeIdentity?
  posCredentials             PosCredential[]
  customerPortfolios         CustomerPortfolioAssignment[]

  @@index([sucursalId])
}

// ─── Módulo POS: identidad, terminales y autorización ───────────────────────────────

model PosCredential {
  id                                String                     @id @default(cuid())
  employeeId                        String?                    @unique
  employee                          Empleado?                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  userId                            String?                    @unique
  user                              Usuario?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  alias                             String
  aliasNormalized                   String                     @unique
  pinHash                           String
  pinFingerprint                    String                     @unique @db.VarChar(64)
  failedAttempts                    Int                        @default(0)
  lockedUntil                       DateTime?
  version                           Int                        @default(1)
  offlineEnabled                    Boolean                    @default(false)
  active                            Boolean                    @default(true)
  creadoEn                          DateTime                   @default(now())
  actualizadoEn                     DateTime                   @updatedAt
  masterProfile                     PosMasterCredential?
  masterAuthorizations              MasterAuthorization[]
  auditLogs                         AuditLog[]
  inventoryBatchesCreated           InventoryAdjustmentBatch[] @relation("InventoryBatchCreated")
  inventoryBatchesResolved          InventoryAdjustmentBatch[] @relation("InventoryBatchResolved")
  inventoryCounts                   InventoryCount[]
  inventoryMovements                InventoryMovement[]
  warehouseRequestsCreated          WarehouseRequest[]         @relation("WarehouseRequestCreated")
  warehouseRequestsCreationApproved WarehouseRequest[]         @relation("WarehouseRequestCreationApproved")
  warehouseRequestsSendApproved     WarehouseRequest[]         @relation("WarehouseRequestSendApproved")
  warehouseRequestsReceived         WarehouseRequest[]         @relation("WarehouseRequestReceived")
  warehouseRequestsCanceled         WarehouseRequest[]         @relation("WarehouseRequestCanceled")
  warehouseRequestEvents            WarehouseRequestEvent[]
  posNotificationsCreated           PosNotification[]
  posNotificationReads              PosNotificationRead[]

  @@index([active, aliasNormalized])
}

model PosMasterCredential {
  id            String        @id @default(cuid())
  credentialId  String        @unique
  credential    PosCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  active        Boolean       @default(true)
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
}

model PosBranchProfile {
  id            String   @id @default(cuid())
  branchId      String   @unique
  branch        Sucursal @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code          String   @unique @db.VarChar(32)
  address       String?
  timezone      String   @default("America/Mexico_City") @db.VarChar(64)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model PosTerminal {
  id                   String                @id @default(cuid())
  code                 String                @unique @db.VarChar(64)
  name                 String                @db.VarChar(120)
  status               PosTerminalStatus     @default(ACTIVE)
  branchId             String
  branch               Sucursal              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  secretHash           String
  secretFingerprint    String                @unique @db.VarChar(64)
  lastSeenAt           DateTime?
  registeredByUserId   String?
  creadoEn             DateTime              @default(now())
  actualizadoEn        DateTime              @updatedAt
  auditLogs            AuditLog[]
  masterAuthorizations MasterAuthorization[]
  inventoryCounts      InventoryCount[]
  inventoryMovements   InventoryMovement[]

  @@index([branchId, status])
}

model PosPermissionNode {
  id             String                  @id
  key            String                  @unique @db.VarChar(80)
  label          String                  @db.VarChar(120)
  description    String?
  parentId       String?
  parent         PosPermissionNode?      @relation("PosPermissionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       PosPermissionNode[]     @relation("PosPermissionTree")
  grantable      Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  active         Boolean                 @default(true)
  positionGrants PositionPosPermission[]
  creadoEn       DateTime                @default(now())
  actualizadoEn  DateTime                @updatedAt

  @@index([parentId, sortOrder])
}

model PositionPosPermission {
  id               String            @id @default(cuid())
  positionId       String
  position         Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permissionNodeId String
  permissionNode   PosPermissionNode @relation(fields: [permissionNodeId], references: [id], onDelete: Cascade)
  allowed          Boolean           @default(true)
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt

  @@unique([positionId, permissionNodeId])
  @@index([permissionNodeId])
}

model MasterAuthorization {
  id                String        @id @default(cuid())
  tokenHash         String        @unique @db.VarChar(64)
  purpose           String        @db.VarChar(80)
  entityType        String?       @db.VarChar(80)
  entityId          String?
  scope             Json?
  actorCredentialId String
  actorCredential   PosCredential @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  terminalId        String
  terminal          PosTerminal   @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  expiresAt         DateTime
  usedAt            DateTime?
  creadoEn          DateTime      @default(now())

  @@index([actorCredentialId, purpose, expiresAt])
  @@index([terminalId, expiresAt])
}

model AuditLog {
  id                String         @id @default(cuid())
  action            String         @db.VarChar(120)
  outcome           String         @db.VarChar(32)
  actorCredentialId String?
  actorCredential   PosCredential? @relation(fields: [actorCredentialId], references: [id], onDelete: SetNull)
  terminalId        String?
  terminal          PosTerminal?   @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  branchId          String?
  branch            Sucursal?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  targetType        String?        @db.VarChar(80)
  targetId          String?
  ipAddress         String?        @db.VarChar(64)
  userAgent         String?        @db.VarChar(512)
  metadata          Json?
  creadoEn          DateTime       @default(now())

  @@index([action, creadoEn])
  @@index([actorCredentialId, creadoEn])
  @@index([terminalId, creadoEn])
}

// ─── Módulo POS: catálogo, clientes, configuración y activos ─────────────────────

enum CatalogItemKind {
  PRODUCT
  SERVICE
  SUPPLY
  MACHINE
}

enum PosAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum PosPriceListStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PosPackageStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum PosVoucherKind {
  NEXT_PURCHASE_DISCOUNT
  COMPANION_FACIAL
  MEMBERSHIP_DISCOUNT
}

enum PosCompetitionType {
  AMOUNT
  PRODUCT
  PACKAGE
  PERIOD
}

model CatalogTaxonomy {
  id                String            @id @default(cuid())
  name              String            @db.VarChar(160)
  normalizedName    String            @db.VarChar(180)
  parentId          String?
  parent            CatalogTaxonomy?  @relation("CatalogTaxonomyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          CatalogTaxonomy[] @relation("CatalogTaxonomyTree")
  active            Boolean           @default(true)
  deletedAt         DateTime?
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt
  catalogFamilies   CatalogItem[]     @relation("CatalogItemFamily")
  catalogCategories CatalogItem[]     @relation("CatalogItemCategory")

  @@unique([parentId, normalizedName])
  @@index([parentId, active])
}

model CatalogItem {
  id                       String                         @id @default(cuid())
  sku                      String                         @unique @db.VarChar(96)
  name                     String                         @db.VarChar(240)
  normalizedName           String                         @db.VarChar(260)
  kind                     CatalogItemKind
  familyId                 String?
  family                   CatalogTaxonomy?               @relation("CatalogItemFamily", fields: [familyId], references: [id], onDelete: Restrict)
  categoryId               String?
  category                 CatalogTaxonomy?               @relation("CatalogItemCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  description              String?
  benefits                 CatalogItemBenefit[]
  published                Boolean                        @default(false)
  active                   Boolean                        @default(true)
  deletedAt                DateTime?
  listPrice                Decimal                        @default(0) @db.Decimal(14, 2)
  minimumPrice             Decimal                        @default(0) @db.Decimal(14, 2)
  unitCost                 Decimal                        @default(0) @db.Decimal(14, 2)
  taxRate                  Decimal                        @default(0) @db.Decimal(8, 2)
  supplierId               String?
  supplier                 PosSupplier?                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  assets                   CatalogAsset[]
  branchVisibility         CatalogItemBranchVisibility[]
  priceHistory             CatalogItemPrice[]
  priceListLines           PosPriceListLine[]
  packageLines             PosPackageLine[]
  inventoryBalances        InventoryBalance[]
  inventoryMovementLines   InventoryMovementLine[]
  inventoryAdjustmentLines InventoryAdjustmentBatchLine[]
  inventoryCountLines      InventoryCountLine[]
  warehouseRequestLines    WarehouseRequestLine[]
  creadoEn                 DateTime                       @default(now())
  actualizadoEn            DateTime                       @updatedAt

  @@index([active, published, kind])
  @@index([familyId, categoryId])
  @@index([supplierId])
}

model CatalogItemBenefit {
  id        String      @id @default(cuid())
  itemId    String
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String      @db.VarChar(500)
  sortOrder Int         @default(0)
  creadoEn  DateTime    @default(now())

  @@unique([itemId, sortOrder])
}

model CatalogItemBranchVisibility {
  id            String      @id @default(cuid())
  itemId        String
  item          CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Sucursal    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visible       Boolean     @default(true)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  @@unique([itemId, branchId])
  @@index([branchId, visible])
}

// Nunca se sobrescribe: cada cambio de precio/costo crea una fila nueva.
model CatalogItemPrice {
  id                    String      @id @default(cuid())
  itemId                String
  item                  CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  listPrice             Decimal     @db.Decimal(14, 2)
  minimumPrice          Decimal     @db.Decimal(14, 2)
  unitCost              Decimal     @db.Decimal(14, 2)
  taxRate               Decimal     @db.Decimal(8, 2)
  effectiveAt           DateTime    @default(now())
  createdByCredentialId String?
  creadoEn              DateTime    @default(now())

  @@index([itemId, effectiveAt])
}

model CatalogAsset {
  id                    String         @id @default(cuid())
  itemId                String
  item                  CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storagePath           String         @unique
  publicUrl             String
  fileName              String         @db.VarChar(255)
  mimeType              String         @db.VarChar(100)
  sizeBytes             Int
  isPrimary             Boolean        @default(false)
  status                PosAssetStatus @default(PENDING)
  createdByCredentialId String?
  creadoEn              DateTime       @default(now())
  actualizadoEn         DateTime       @updatedAt

  @@index([itemId, status])
}

model CustomerSource {
  id            String     @id @default(cuid())
  name          String     @unique @db.VarChar(160)
  active        Boolean    @default(true)
  deletedAt     DateTime?
  customers     Customer[]
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
}

model Customer {
  id                   String                        @id @default(cuid())
  displayName          String                        @db.VarChar(240)
  normalizedName       String                        @db.VarChar(260)
  phone                String?                       @unique @db.VarChar(32)
  email                String?                       @db.VarChar(320)
  sourceId             String?
  source               CustomerSource?               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  notes                String?
  active               Boolean                       @default(true)
  deletedAt            DateTime?
  portfolios           CustomerPortfolioAssignment[]
  priceListAssignments PriceListCustomerAssignment[]
  warehouseRequests    WarehouseRequest[]
  creadoEn             DateTime                      @default(now())
  actualizadoEn        DateTime                      @updatedAt

  @@index([normalizedName, active])
  @@index([sourceId])
}

// Versionar la cartera preserva quién atendía al cliente en cualquier fecha.
model CustomerPortfolioAssignment {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId              String?
  branch                Sucursal? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employeeId            String?
  employee              Empleado? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdByCredentialId String?
  creadoEn              DateTime  @default(now())

  @@index([customerId, effectiveFrom, effectiveTo])
  @@index([branchId, employeeId])
}

model PosPaymentMethodPolicy {
  id                String     @id @default(cuid())
  paymentMethodId   String     @unique
  paymentMethod     MetodoPago @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  requiresReference Boolean    @default(false)
  referenceLabel    String?    @db.VarChar(80)
  minAmount         Decimal?   @db.Decimal(14, 2)
  maxAmount         Decimal?   @db.Decimal(14, 2)
  activeForPos      Boolean    @default(true)
  creadoEn          DateTime   @default(now())
  actualizadoEn     DateTime   @updatedAt
}

model PosTicketConfiguration {
  id                       String   @id @default(cuid())
  branchId                 String?  @unique
  logoAssetId              String?
  companyName              String   @default("KEYSAR COSMETICS") @db.VarChar(160)
  address                  String?
  footerMessage            String?
  policies                 String?
  showClientName           Boolean  @default(true)
  showClientPhone          Boolean  @default(true)
  showSellerName           Boolean  @default(true)
  showVatBreakdown         Boolean  @default(true)
  showSpareCoverageMessage Boolean  @default(true)
  creadoEn                 DateTime @default(now())
  actualizadoEn            DateTime @updatedAt
}

model PosCustomerRequiredField {
  id            String   @id @default(cuid())
  key           String   @unique @db.VarChar(80)
  label         String   @db.VarChar(120)
  required      Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model PosCourtesyPolicy {
  id                    String    @id @default(cuid())
  name                  String    @unique @db.VarChar(160)
  description           String?
  requiresCustomer      Boolean   @default(true)
  requiresAuthorization Boolean   @default(true)
  active                Boolean   @default(true)
  deletedAt             DateTime?
  creadoEn              DateTime  @default(now())
  actualizadoEn         DateTime  @updatedAt
}

model PosVoucherTemplate {
  id               String         @id @default(cuid())
  name             String         @unique @db.VarChar(160)
  kind             PosVoucherKind
  value            Decimal        @db.Decimal(14, 2)
  message          String         @db.VarChar(1000)
  active           Boolean        @default(true)
  visibleToSellers Boolean        @default(false)
  deletedAt        DateTime?
  creadoEn         DateTime       @default(now())
  actualizadoEn    DateTime       @updatedAt
}

model PosSupplier {
  id                String             @id @default(cuid())
  folio             String             @unique @db.VarChar(64)
  businessName      String             @db.VarChar(240)
  normalizedName    String             @unique @db.VarChar(260)
  contactName       String?
  rfc               String?            @db.VarChar(20)
  taxRegime         String?
  businessLine      String?
  phone             String?
  email             String?
  address           String?
  active            Boolean            @default(true)
  deletedAt         DateTime?
  catalogItems      CatalogItem[]
  priceLists        PosPriceList[]
  warehouseRequests WarehouseRequest[]
  creadoEn          DateTime           @default(now())
  actualizadoEn     DateTime           @updatedAt

  @@index([active, normalizedName])
}

model PosPriceList {
  id                  String                        @id @default(cuid())
  name                String                        @db.VarChar(160)
  version             Int                           @default(1)
  status              PosPriceListStatus            @default(DRAFT)
  supplierId          String?
  supplier            PosSupplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  lines               PosPriceListLine[]
  branchAssignments   PriceListBranchAssignment[]
  customerAssignments PriceListCustomerAssignment[]
  warehouseRequests   WarehouseRequest[]
  deletedAt           DateTime?
  creadoEn            DateTime                      @default(now())
  actualizadoEn       DateTime                      @updatedAt

  @@unique([name, version])
  @@index([status, effectiveFrom, effectiveTo])
}

model PosPriceListLine {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PosPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId      String
  item        CatalogItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  price       Decimal      @db.Decimal(14, 2)
  cost        Decimal?     @db.Decimal(14, 2)
  creadoEn    DateTime     @default(now())

  @@unique([priceListId, itemId])
}

model PriceListBranchAssignment {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PosPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Sucursal     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([priceListId, branchId])
}

model PriceListCustomerAssignment {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PosPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([priceListId, customerId])
}

model PosPackage {
  id            String           @id @default(cuid())
  name          String           @db.VarChar(160)
  sku           String           @unique @db.VarChar(96)
  description   String?
  price         Decimal          @db.Decimal(14, 2)
  status        PosPackageStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  lines         PosPackageLine[]
  deletedAt     DateTime?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  @@index([status, startsAt, endsAt])
}

model PosPackageLine {
  id        String      @id @default(cuid())
  packageId String
  package   PosPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itemId    String
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Decimal     @db.Decimal(14, 2)

  @@unique([packageId, itemId])
}

model PosSalesCompetition {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(160)
  type           PosCompetitionType
  active         Boolean            @default(true)
  dateFrom       DateTime           @db.Date
  dateTo         DateTime           @db.Date
  branchId       String?
  branch         Sucursal?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  targetAmount   Decimal?           @db.Decimal(14, 2)
  itemId         String?
  packageItemIds Json?
  deletedAt      DateTime?
  creadoEn       DateTime           @default(now())
  actualizadoEn  DateTime           @updatedAt

  @@index([active, dateFrom, dateTo])
  @@index([branchId])
}

// ─── Módulo POS: inventario, conteos y bodega matriz ──────────────────

enum InventoryLocationType {
  BRANCH
  WAREHOUSE
}

enum InventoryMovementType {
  ADD
  REMOVE
  TRANSFER
  RETURN
  DEMO
  WRITE_OFF
  REVERSAL
  COUNT_ADJUSTMENT
  WAREHOUSE_SHIPMENT
  WAREHOUSE_RECEIPT
  SUPPLIER_RECEIPT
}

enum InventoryMovementStatus {
  APPLIED
  REVERSED
}

enum InventoryAdjustmentBatchStatus {
  PENDING
  APPLIED
  CANCELED
  REVERSED
}

enum InventoryCountKind {
  OPENING
  CLOSING
}

enum WarehouseRequestType {
  PRODUCT
  TESTER
  SUPPLY
}

enum WarehouseRequestSource {
  BRANCH
  SUPPLIER
}

enum WarehouseRequestStatus {
  REQUESTED
  CREATION_APPROVED
  SEND_APPROVED
  SHIPPED
  RECEIVED
  CANCELED
}

enum PosNotificationKind {
  WAREHOUSE_REQUESTED
  WAREHOUSE_CREATION_APPROVED
  WAREHOUSE_SHIPPED
  WAREHOUSE_RECEIVED
  WAREHOUSE_RETURNED
  WAREHOUSE_CANCELED
}

model PosIdempotencyRecord {
  id                String   @id @default(cuid())
  key               String   @unique @db.Uuid
  actorCredentialId String
  operation         String   @db.VarChar(120)
  requestHash       String   @db.VarChar(64)
  responseStatus    Int
  responseBody      Json
  creadoEn          DateTime @default(now())

  @@index([actorCredentialId, creadoEn])
}

model InventoryLocation {
  id                    String                         @id @default(cuid())
  code                  String                         @unique @db.VarChar(64)
  name                  String                         @db.VarChar(160)
  type                  InventoryLocationType
  branchId              String?                        @unique
  branch                Sucursal?                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  active                Boolean                        @default(true)
  balances              InventoryBalance[]
  movementsFrom         InventoryMovementLine[]        @relation("InventoryMovementFrom")
  movementsTo           InventoryMovementLine[]        @relation("InventoryMovementTo")
  adjustmentFrom        InventoryAdjustmentBatchLine[] @relation("InventoryAdjustmentFrom")
  adjustmentTo          InventoryAdjustmentBatchLine[] @relation("InventoryAdjustmentTo")
  counts                InventoryCount[]
  warehouseSources      WarehouseRequest[]             @relation("WarehouseRequestSourceLocation")
  warehouseDestinations WarehouseRequest[]             @relation("WarehouseRequestDestinationLocation")
  creadoEn              DateTime                       @default(now())
  actualizadoEn         DateTime                       @updatedAt

  @@index([type, active])
}

model InventoryBalance {
  id                String            @id @default(cuid())
  locationId        String
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId            String
  item              CatalogItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  availableQuantity Decimal           @default(0) @db.Decimal(14, 2)
  reservedQuantity  Decimal           @default(0) @db.Decimal(14, 2)
  version           Int               @default(0)
  actualizadoEn     DateTime          @updatedAt

  @@unique([locationId, itemId])
  @@index([itemId])
}

model InventoryMovement {
  id                 String                    @id @default(cuid())
  folio              String                    @unique @db.VarChar(64)
  type               InventoryMovementType
  status             InventoryMovementStatus   @default(APPLIED)
  reason             String?                   @db.VarChar(240)
  notes              String?                   @db.VarChar(1000)
  businessDate       DateTime                  @db.Date
  actorCredentialId  String
  actorCredential    PosCredential             @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  terminalId         String
  terminal           PosTerminal               @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  adjustmentBatchId  String?                   @unique
  adjustmentBatch    InventoryAdjustmentBatch? @relation(fields: [adjustmentBatchId], references: [id], onDelete: Restrict)
  warehouseRequestId String?
  warehouseRequest   WarehouseRequest?         @relation(fields: [warehouseRequestId], references: [id], onDelete: Restrict)
  countId            String?                   @unique
  count              InventoryCount?           @relation(fields: [countId], references: [id], onDelete: Restrict)
  reversalOfId       String?                   @unique
  reversalOf         InventoryMovement?        @relation("InventoryMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         InventoryMovement?        @relation("InventoryMovementReversal")
  lines              InventoryMovementLine[]
  creadoEn           DateTime                  @default(now())

  @@index([businessDate, creadoEn])
  @@index([adjustmentBatchId])
  @@index([warehouseRequestId])
}

model InventoryMovementLine {
  id                 String             @id @default(cuid())
  movementId         String
  movement           InventoryMovement  @relation(fields: [movementId], references: [id], onDelete: Restrict)
  itemId             String
  item               CatalogItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLocationId     String?
  fromLocation       InventoryLocation? @relation("InventoryMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId       String?
  toLocation         InventoryLocation? @relation("InventoryMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  quantity           Decimal            @db.Decimal(14, 2)
  fromQuantityBefore Decimal?           @db.Decimal(14, 2)
  fromQuantityAfter  Decimal?           @db.Decimal(14, 2)
  toQuantityBefore   Decimal?           @db.Decimal(14, 2)
  toQuantityAfter    Decimal?           @db.Decimal(14, 2)
  unitCostSnapshot   Decimal?           @db.Decimal(14, 2)
  metadata           Json?
  creadoEn           DateTime           @default(now())

  @@index([itemId, creadoEn])
  @@index([fromLocationId, creadoEn])
  @@index([toLocationId, creadoEn])
}

model InventoryAdjustmentBatch {
  id                     String                         @id @default(cuid())
  folio                  String                         @unique @db.VarChar(64)
  status                 InventoryAdjustmentBatchStatus @default(PENDING)
  notes                  String?                        @db.VarChar(1000)
  createdByCredentialId  String
  createdByCredential    PosCredential                  @relation("InventoryBatchCreated", fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  resolvedByCredentialId String?
  resolvedByCredential   PosCredential?                 @relation("InventoryBatchResolved", fields: [resolvedByCredentialId], references: [id], onDelete: Restrict)
  resolvedAt             DateTime?
  lines                  InventoryAdjustmentBatchLine[]
  movement               InventoryMovement?
  creadoEn               DateTime                       @default(now())
  actualizadoEn          DateTime                       @updatedAt

  @@index([status, creadoEn])
}

model InventoryAdjustmentBatchLine {
  id             String                   @id @default(cuid())
  batchId        String
  batch          InventoryAdjustmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId         String
  item           CatalogItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type           InventoryMovementType
  fromLocationId String?
  fromLocation   InventoryLocation?       @relation("InventoryAdjustmentFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String?
  toLocation     InventoryLocation?       @relation("InventoryAdjustmentTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  quantity       Decimal                  @db.Decimal(14, 2)
  reason         String?                  @db.VarChar(240)
  notes          String?                  @db.VarChar(1000)
  creadoEn       DateTime                 @default(now())

  @@index([batchId])
}

model InventoryCount {
  id                    String               @id @default(cuid())
  kind                  InventoryCountKind
  businessDate          DateTime             @db.Date
  locationId            String
  location              InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  notes                 String?              @db.VarChar(500)
  createdByCredentialId String
  createdByCredential   PosCredential        @relation(fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  terminalId            String
  terminal              PosTerminal          @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  lines                 InventoryCountLine[]
  movement              InventoryMovement?
  creadoEn              DateTime             @default(now())

  @@unique([locationId, businessDate, kind])
  @@index([businessDate, kind])
}

model InventoryCountLine {
  id                 String         @id @default(cuid())
  countId            String
  count              InventoryCount @relation(fields: [countId], references: [id], onDelete: Restrict)
  itemId             String
  item               CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  countedQuantity    Decimal        @db.Decimal(14, 2)
  expectedQuantity   Decimal        @db.Decimal(14, 2)
  differenceQuantity Decimal        @db.Decimal(14, 2)
  unitCostSnapshot   Decimal?       @db.Decimal(14, 2)
  matchesExpected    Boolean

  @@unique([countId, itemId])
}

model WarehouseRequest {
  id                             String                  @id @default(cuid())
  folio                          String                  @unique @db.VarChar(64)
  source                         WarehouseRequestSource
  requestType                    WarehouseRequestType
  status                         WarehouseRequestStatus  @default(REQUESTED)
  branchId                       String?
  branch                         Sucursal?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId                     String?
  supplier                       PosSupplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  priceListId                    String?
  priceList                      PosPriceList?           @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  customerId                     String?
  customer                       Customer?               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceLocationId               String?
  sourceLocation                 InventoryLocation?      @relation("WarehouseRequestSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocationId          String
  destinationLocation            InventoryLocation       @relation("WarehouseRequestDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  notes                          String?                 @db.VarChar(1000)
  createdByCredentialId          String
  createdByCredential            PosCredential           @relation("WarehouseRequestCreated", fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  creationApprovedByCredentialId String?
  creationApprovedByCredential   PosCredential?          @relation("WarehouseRequestCreationApproved", fields: [creationApprovedByCredentialId], references: [id], onDelete: Restrict)
  creationApprovedAt             DateTime?
  sendApprovedByCredentialId     String?
  sendApprovedByCredential       PosCredential?          @relation("WarehouseRequestSendApproved", fields: [sendApprovedByCredentialId], references: [id], onDelete: Restrict)
  sendApprovedAt                 DateTime?
  shippedAt                      DateTime?
  receivedByCredentialId         String?
  receivedByCredential           PosCredential?          @relation("WarehouseRequestReceived", fields: [receivedByCredentialId], references: [id], onDelete: Restrict)
  receivedAt                     DateTime?
  canceledByCredentialId         String?
  canceledByCredential           PosCredential?          @relation("WarehouseRequestCanceled", fields: [canceledByCredentialId], references: [id], onDelete: Restrict)
  canceledAt                     DateTime?
  lines                          WarehouseRequestLine[]
  events                         WarehouseRequestEvent[]
  movements                      InventoryMovement[]
  notifications                  PosNotification[]
  creadoEn                       DateTime                @default(now())
  actualizadoEn                  DateTime                @updatedAt

  @@index([status, creadoEn])
  @@index([branchId, status])
  @@index([supplierId, status])
}

model WarehouseRequestLine {
  id                    String           @id @default(cuid())
  requestId             String
  request               WarehouseRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  itemId                String
  item                  CatalogItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity              Decimal          @db.Decimal(14, 2)
  itemNameSnapshot      String           @db.VarChar(240)
  skuSnapshot           String           @db.VarChar(96)
  unitCostSnapshot      Decimal?         @db.Decimal(14, 2)
  priceSnapshot         Decimal?         @db.Decimal(14, 2)
  priceListNameSnapshot String?          @db.VarChar(160)
  customerNameSnapshot  String?          @db.VarChar(240)

  @@unique([requestId, itemId])
}

model WarehouseRequestEvent {
  id                String                  @id @default(cuid())
  requestId         String
  request           WarehouseRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  fromStatus        WarehouseRequestStatus?
  toStatus          WarehouseRequestStatus
  action            String                  @db.VarChar(80)
  actorCredentialId String
  actorCredential   PosCredential           @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  notes             String?                 @db.VarChar(1000)
  creadoEn          DateTime                @default(now())

  @@index([requestId, creadoEn])
}

model PosNotification {
  id                    String                @id @default(cuid())
  kind                  PosNotificationKind
  title                 String                @db.VarChar(240)
  message               String                @db.VarChar(1000)
  branchId              String?
  branch                Sucursal?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  audiencePermission    String?               @db.VarChar(80)
  warehouseRequestId    String?
  warehouseRequest      WarehouseRequest?     @relation(fields: [warehouseRequestId], references: [id], onDelete: SetNull)
  createdByCredentialId String?
  createdByCredential   PosCredential?        @relation(fields: [createdByCredentialId], references: [id], onDelete: SetNull)
  reads                 PosNotificationRead[]
  creadoEn              DateTime              @default(now())

  @@index([branchId, creadoEn])
  @@index([audiencePermission, creadoEn])
}

model PosNotificationRead {
  id             String          @id @default(cuid())
  notificationId String
  notification   PosNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  credentialId   String
  credential     PosCredential   @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  readAt         DateTime        @default(now())

  @@unique([notificationId, credentialId])
  @@index([credentialId, readAt])
}

enum TipoCompraCita {
  PAGO_NETO
  COMPRA_CON_APARTADO
  PAGO_DE_APARTADO
}

enum EstatusCita {
  ATENDIDA
  NO_LLEGO
  CANCELADA
}

// Registro operativo de una cita atendida; más adelante podrá vincularse con Scheduler.
model RegistroCita {
  id              String               @id @default(cuid())
  fecha           DateTime
  hora            String?              @db.VarChar(5)
  subcategoriaId  String
  subcategoria    SubcategoriaAtencion @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  estatus         EstatusCita          @default(ATENDIDA)
  nombreCliente   String
  sucursalId      String
  sucursal        Sucursal             @relation(fields: [sucursalId], references: [id])
  vendedorId      String
  vendedor        Empleado             @relation("RegistroCitaVendedor", fields: [vendedorId], references: [id])
  facialistaId    String
  facialista      Empleado             @relation("RegistroCitaFacialista", fields: [facialistaId], references: [id])
  tipoCompra      TipoCompraCita?
  montoCompra     Decimal              @default(0) @db.Decimal(10, 2)
  montoApartado   Decimal              @default(0) @db.Decimal(10, 2)
  bonoSalidaTarde Boolean              @default(false)
  bonoComida      Boolean              @default(false)
  creadoPorId     String
  creadoPor       Usuario              @relation(fields: [creadoPorId], references: [id])
  creadoEn        DateTime             @default(now())
  actualizadoEn   DateTime             @updatedAt

  @@index([fecha])
  @@index([estatus, fecha])
  @@index([sucursalId, fecha])
  @@index([facialistaId, fecha])
  @@index([vendedorId, fecha])
  @@index([creadoPorId])
  @@index([subcategoriaId])
}

// Agrupa todas las ventas de un vendedor en un día
model Venta {
  id            String         @id @default(cuid())
  fecha         DateTime
  notas         String?
  // Vincula registros guardados juntos (mismo voucher multi-vendedor); nullable = venta individual
  sesionId      String?
  sucursalId    String
  sucursal      Sucursal       @relation(fields: [sucursalId], references: [id])
  vendedorId    String
  vendedor      Empleado       @relation(fields: [vendedorId], references: [id])
  detalles      VentaDetalle[]
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  @@index([fecha])
  @@index([sucursalId, fecha])
  @@index([vendedorId, fecha])
  @@index([sesionId])
}

// Cada fila = una venta individual con monto y método de pago
model VentaDetalle {
  id            String     @id @default(cuid())
  cantidad      Decimal    @db.Decimal(10, 2)
  ventaId       String
  venta         Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodoPagoId  String
  metodoPago    MetodoPago @relation(fields: [metodoPagoId], references: [id])
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@index([ventaId])
  @@index([metodoPagoId])
}

// ─── Módulo Payroll ───────────────────────────────────────────────────────────────────

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELED
}

enum PayrollCalculationMode {
  WITH_VAT
  WITHOUT_VAT
}

enum PayrollMovementKind {
  BONUS
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  FINE
  PER_DIEM
  SUPPLIES
}

enum PayrollMovementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollMovementPayrollType {
  FIXED_SALARY
  SPECIALIST
  COMMISSION
  MANAGEMENT_COMMISSION
}

enum PayrollCatalogKind {
  BONUS
  FINE
  PER_DIEM
}

enum PayrollExpenseKind {
  FIXED
  VARIABLE
}

enum PayrollExpenseFrequency {
  ONE_TIME
  BIWEEKLY
  MONTHLY
}

enum LoanAdvanceKind {
  LOAN
  PAYROLL_ADVANCE
}

enum LoanAdvanceStatus {
  PENDING
  PAID
  LOST
  CANCELED
}

enum LoanInstallmentStatus {
  SCHEDULED
  RESERVED
  PAID
  CANCELED
}

enum PayrollReceiptStatus {
  GENERATED
  SENT
  CONFIRMED
}

model PayrollCatalogItem {
  id            String             @id @default(cuid())
  kind          PayrollCatalogKind
  name          String
  defaultAmount Decimal            @db.Decimal(14, 2)
  notes         String?
  active        Boolean            @default(true)
  createdById   String
  createdBy     Usuario            @relation("PayrollCatalogItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  movements     PayrollMovement[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([kind, name])
  @@index([kind, active])
}

model CommissionScheme {
  id          String                         @id @default(cuid())
  name        String                         @unique
  active      Boolean                        @default(true)
  versions    CommissionSchemeVersion[]
  assignments EmployeeCommissionAssignment[]
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
}

model CommissionSchemeVersion {
  id            String                 @id @default(cuid())
  schemeId      String
  scheme        CommissionScheme       @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  version       Int
  effectiveFrom DateTime               @db.Date
  createdById   String
  createdBy     Usuario                @relation("CommissionSchemeVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tiers         CommissionSchemeTier[]
  createdAt     DateTime               @default(now())

  @@unique([schemeId, version])
  @@unique([schemeId, effectiveFrom])
  @@index([effectiveFrom])
}

model CommissionSchemeTier {
  id         String                  @id @default(cuid())
  versionId  String
  version    CommissionSchemeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromAmount Decimal                 @db.Decimal(14, 2)
  toAmount   Decimal?                @db.Decimal(14, 2)
  rate       Decimal                 @db.Decimal(8, 6)
  sortOrder  Int

  @@unique([versionId, sortOrder])
}

model EmployeeCommissionAssignment {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Empleado         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  schemeId      String
  scheme        CommissionScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime         @db.Date
  effectiveTo   DateTime?        @db.Date
  createdById   String
  createdBy     Usuario          @relation("EmployeeCommissionAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([schemeId])
}

model PayrollRun {
  id              String                   @id @default(cuid())
  periodStart     DateTime                 @db.Date
  periodEnd       DateTime                 @db.Date
  payDate         DateTime                 @db.Date
  mode            PayrollCalculationMode
  vatRate         Decimal                  @default(0.16) @db.Decimal(8, 6)
  status          PayrollRunStatus         @default(DRAFT)
  salesWithVat    Decimal                  @default(0) @db.Decimal(14, 2)
  salesWithoutVat Decimal                  @default(0) @db.Decimal(14, 2)
  expenseTotal    Decimal                  @default(0) @db.Decimal(14, 2)
  payrollTotal    Decimal                  @default(0) @db.Decimal(14, 2)
  generalBalance  Decimal                  @default(0) @db.Decimal(14, 2)
  warnings        Json?
  createdById     String
  createdBy       Usuario                  @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      Usuario?                 @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidById        String?
  paidBy          Usuario?                 @relation("PayrollRunPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?
  paidAt          DateTime?
  canceledAt      DateTime?
  lines           PayrollRunLine[]
  movements       PayrollMovement[]
  expenses        PayrollExpense[]
  installments    LoanAdvanceInstallment[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([periodStart, periodEnd])
  @@index([status, periodStart])
}

model PayrollRunLine {
  id                 String                 @id @default(cuid())
  payrollRunId       String
  payrollRun         PayrollRun             @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Empleado               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName       String
  positionName       String?
  bankName           String?
  accountNumber      String?
  phoneNumber        String?
  schemeName         String?
  schemeVersion      Int?
  individualRate     Decimal?               @db.Decimal(8, 6)
  monthlySalary      Decimal                @default(0) @db.Decimal(14, 2)
  salaryPayment      Decimal                @default(0) @db.Decimal(14, 2)
  salesWithVat       Decimal                @default(0) @db.Decimal(14, 2)
  salesWithoutVat    Decimal                @default(0) @db.Decimal(14, 2)
  commission         Decimal                @default(0) @db.Decimal(14, 2)
  bonus              Decimal                @default(0) @db.Decimal(14, 2)
  fine               Decimal                @default(0) @db.Decimal(14, 2)
  adjustmentPositive Decimal                @default(0) @db.Decimal(14, 2)
  adjustmentNegative Decimal                @default(0) @db.Decimal(14, 2)
  perDiem            Decimal                @default(0) @db.Decimal(14, 2)
  supplies           Decimal                @default(0) @db.Decimal(14, 2)
  loanPayment        Decimal                @default(0) @db.Decimal(14, 2)
  totalPayment       Decimal                @default(0) @db.Decimal(14, 2)
  warnings           Json?
  branchLines        PayrollRunBranchLine[]
  receipt            PayrollReceipt?
  createdAt          DateTime               @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollRunBranchLine {
  id                 String         @id @default(cuid())
  payrollRunLineId   String
  payrollRunLine     PayrollRunLine @relation(fields: [payrollRunLineId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Sucursal?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchName         String
  salesWithVat       Decimal        @default(0) @db.Decimal(14, 2)
  salesWithoutVat    Decimal        @default(0) @db.Decimal(14, 2)
  commission         Decimal        @default(0) @db.Decimal(14, 2)
  bonus              Decimal        @default(0) @db.Decimal(14, 2)
  fine               Decimal        @default(0) @db.Decimal(14, 2)
  salaryPayment      Decimal        @default(0) @db.Decimal(14, 2)
  adjustmentPositive Decimal        @default(0) @db.Decimal(14, 2)
  adjustmentNegative Decimal        @default(0) @db.Decimal(14, 2)
  perDiem            Decimal        @default(0) @db.Decimal(14, 2)
  supplies           Decimal        @default(0) @db.Decimal(14, 2)
  loanPayment        Decimal        @default(0) @db.Decimal(14, 2)
  totalCost          Decimal        @default(0) @db.Decimal(14, 2)

  @@unique([payrollRunLineId, branchName])
  @@index([branchId])
}

model PayrollMovement {
  id            String                      @id @default(cuid())
  date          DateTime                    @db.Date
  kind          PayrollMovementKind
  payrollType   PayrollMovementPayrollType?
  catalogItemId String?
  catalogItem   PayrollCatalogItem?         @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  concept       String
  totalAmount   Decimal                     @db.Decimal(14, 2)
  status        PayrollMovementStatus       @default(PENDING)
  notes         String?
  payrollRunId  String?
  payrollRun    PayrollRun?                 @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     Usuario                     @relation("PayrollMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    Usuario?                    @relation("PayrollMovementReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt    DateTime?
  allocations   PayrollMovementAllocation[]
  attachments   PayrollAttachment[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([date, status])
  @@index([payrollRunId])
}

model PayrollMovementAllocation {
  id             String          @id @default(cuid())
  movementId     String
  movement       PayrollMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Empleado        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Sucursal?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount         Decimal         @db.Decimal(14, 2)
  commissionable Boolean         @default(true)

  @@unique([movementId, employeeId])
  @@index([employeeId])
  @@index([branchId])
}

model PayrollAttachment {
  id          String          @id @default(cuid())
  movementId  String
  movement    PayrollMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  storagePath String          @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime        @default(now())

  @@index([movementId])
}

model PayrollExpense {
  id                  String                           @id @default(cuid())
  date                DateTime                         @db.Date
  kind                PayrollExpenseKind
  concept             String
  category            String
  categoryId          String?
  categoryRecord      PayrollExpenseCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branchId            String?
  branch              Sucursal?                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  costCenter          String
  amount              Decimal                          @db.Decimal(14, 2)
  frequency           PayrollExpenseFrequency
  notes               String?
  payrollRunId        String?
  payrollRun          PayrollRun?                      @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  recurrenceId        String?
  recurrence          PayrollExpenseRecurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  recurrenceVersionId String?
  recurrenceVersion   PayrollExpenseRecurrenceVersion? @relation(fields: [recurrenceVersionId], references: [id], onDelete: Restrict)
  generated           Boolean                          @default(false)
  createdById         String
  createdBy           Usuario                          @relation("PayrollExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedAt           DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@unique([recurrenceVersionId, date])
  @@index([date, deletedAt])
  @@index([payrollRunId])
  @@index([branchId])
  @@index([categoryId])
  @@index([recurrenceId, date])
}

model PayrollExpenseCategory {
  id                 String                            @id @default(cuid())
  name               String                            @unique
  active             Boolean                           @default(true)
  createdById        String
  createdBy          Usuario                           @relation("PayrollExpenseCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses           PayrollExpense[]
  recurrenceVersions PayrollExpenseRecurrenceVersion[]
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@index([active, name])
}

model PayrollExpenseRecurrence {
  id          String                            @id @default(cuid())
  active      Boolean                           @default(true)
  endedAt     DateTime?                         @db.Date
  createdById String
  createdBy   Usuario                           @relation("PayrollExpenseRecurrenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions    PayrollExpenseRecurrenceVersion[]
  expenses    PayrollExpense[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@index([active])
}

model PayrollExpenseRecurrenceVersion {
  id             String                   @id @default(cuid())
  recurrenceId   String
  recurrence     PayrollExpenseRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  anchorDate     DateTime                 @db.Date
  effectiveFrom  DateTime                 @db.Date
  effectiveTo    DateTime?                @db.Date
  kind           PayrollExpenseKind
  concept        String
  category       String
  categoryId     String?
  categoryRecord PayrollExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Sucursal?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  costCenter     String
  amount         Decimal                  @db.Decimal(14, 2)
  frequency      PayrollExpenseFrequency
  notes          String?
  createdById    String
  createdBy      Usuario                  @relation("PayrollExpenseRecurrenceVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses       PayrollExpense[]
  createdAt      DateTime                 @default(now())

  @@unique([recurrenceId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@index([branchId])
  @@index([categoryId])
}

model LoanAdvance {
  id                String                   @id @default(cuid())
  requestedAt       DateTime                 @db.Date
  employeeId        String
  employee          Empleado                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind              LoanAdvanceKind
  requestedAmount   Decimal                  @db.Decimal(14, 2)
  installmentCount  Int
  installmentAmount Decimal                  @db.Decimal(14, 2)
  paidAmount        Decimal                  @default(0) @db.Decimal(14, 2)
  balance           Decimal                  @db.Decimal(14, 2)
  status            LoanAdvanceStatus        @default(PENDING)
  notes             String?
  createdById       String
  createdBy         Usuario                  @relation("LoanAdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  installments      LoanAdvanceInstallment[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([employeeId, status])
  @@index([requestedAt])
}

model LoanAdvanceInstallment {
  id            String                @id @default(cuid())
  loanAdvanceId String
  loanAdvance   LoanAdvance           @relation(fields: [loanAdvanceId], references: [id], onDelete: Cascade)
  sequence      Int
  periodStart   DateTime              @db.Date
  periodEnd     DateTime              @db.Date
  amount        Decimal               @db.Decimal(14, 2)
  status        LoanInstallmentStatus @default(SCHEDULED)
  payrollRunId  String?
  payrollRun    PayrollRun?           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  paidAt        DateTime?

  @@unique([loanAdvanceId, sequence])
  @@index([periodStart, periodEnd, status])
  @@index([payrollRunId])
}

model PayrollReceipt {
  id               String               @id @default(cuid())
  payrollRunLineId String               @unique
  payrollRunLine   PayrollRunLine       @relation(fields: [payrollRunLineId], references: [id], onDelete: Restrict)
  status           PayrollReceiptStatus @default(GENERATED)
  sentAt           DateTime?
  sentById         String?
  sentBy           Usuario?             @relation("PayrollReceiptSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      Usuario?             @relation("PayrollReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

model PayrollAuditEvent {
  id         String   @id @default(cuid())
  userId     String
  user       Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}
