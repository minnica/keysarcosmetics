  @@index([branchProfileId, active])
}

model SchedulerServiceProfile {
  id                      String                                   @id @default(cuid())
  catalogItemId           String                                   @unique
  catalogItem             CatalogItem                              @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  durationMinutes         Int
  preparationMinutes      Int                                      @default(0)
  cleanupMinutes          Int                                      @default(0)
  capacity                Int                                      @default(1)
