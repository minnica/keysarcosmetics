  professionalProfileId String
  professionalProfile   SchedulerProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  specialtyId           String
  specialty             SchedulerSpecialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  active                Boolean                      @default(true)
  effectiveFrom         DateTime                     @default(now())
  effectiveTo           DateTime?
  creadoEn              DateTime                     @default(now())
  actualizadoEn         DateTime                     @updatedAt

  @@unique([professionalProfileId, specialtyId])
  @@index([specialtyId, active])
}

model SchedulerProfessionalGroup {
  id              String                             @id @default(cuid())
  commerceId      String
  commerce        SchedulerCommerce                  @relation(fields: [commerceId], references: [id], onDelete: Restrict)
  branchProfileId String
  branchProfile   SchedulerBranchProfile             @relation(fields: [branchProfileId], references: [id], onDelete: Restrict)
  name            String                             @db.VarChar(160)
  normalizedName  String                             @db.VarChar(180)
  active          Boolean                            @default(true)
  effectiveFrom   DateTime                           @default(now())
  effectiveTo     DateTime?
  deactivatedAt   DateTime?
  members         SchedulerProfessionalGroupMember[]
  creadoEn        DateTime                           @default(now())
  actualizadoEn   DateTime                           @updatedAt

  @@unique([branchProfileId, normalizedName])
  @@index([commerceId, active])
}

model SchedulerProfessionalGroupMember {
  id                    String                       @id @default(cuid())
  groupId               String
  group                 SchedulerProfessionalGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  professionalProfileId String
  professionalProfile   SchedulerProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  active                Boolean                      @default(true)
  effectiveFrom         DateTime                     @default(now())
  effectiveTo           DateTime?
  creadoEn              DateTime                     @default(now())
  actualizadoEn         DateTime                     @updatedAt

  @@unique([groupId, professionalProfileId])
  @@index([professionalProfileId, active])
}

model SchedulerResource {
  id                     String                                @id @default(cuid())
  branchProfileId        String
  branchProfile          SchedulerBranchProfile                @relation(fields: [branchProfileId], references: [id], onDelete: Restrict)
  name                   String                                @db.VarChar(160)
  normalizedName         String                                @db.VarChar(180)
  kind                   SchedulerResourceKind
  capacity               Int                                   @default(1)
  exclusive              Boolean                               @default(true)
  acceptsOnline          Boolean                               @default(false)
  active                 Boolean                               @default(true)
  effectiveFrom          DateTime                              @default(now())
  effectiveTo            DateTime?
  deactivatedAt          DateTime?
  version                Int                                   @default(1)
  serviceRequirements    SchedulerServiceResourceRequirement[]
  availabilityRules      SchedulerAvailabilityRule[]
  availabilityExceptions SchedulerAvailabilityException[]
  creadoEn               DateTime                              @default(now())
  actualizadoEn          DateTime                              @updatedAt

  @@unique([branchProfileId, normalizedName])
  @@index([branchProfileId, active])
}

model SchedulerServiceResourceRequirement {
  id               String                  @id @default(cuid())
  serviceProfileId String
  serviceProfile   SchedulerServiceProfile @relation(fields: [serviceProfileId], references: [id], onDelete: Restrict)
  resourceId       String
  resource         SchedulerResource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  requiredUnits    Int                     @default(1)
  exclusive        Boolean                 @default(true)
  active           Boolean                 @default(true)
  effectiveFrom    DateTime                @default(now())
  effectiveTo      DateTime?
  creadoEn         DateTime                @default(now())
  actualizadoEn    DateTime                @updatedAt

  @@unique([serviceProfileId, resourceId])
  @@index([resourceId, active])
}

model SchedulerAvailabilityRule {
  id                    String                        @id @default(cuid())
  branchProfileId       String
  branchProfile         SchedulerBranchProfile        @relation(fields: [branchProfileId], references: [id], onDelete: Restrict)
  professionalProfileId String?
  professionalProfile   SchedulerProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  resourceId            String?
  resource              SchedulerResource?            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  kind                  SchedulerAvailabilityRuleKind
  weekday               SchedulerWeekday
  startMinute           Int
  endMinute             Int
  active                Boolean                       @default(true)
  effectiveFrom         DateTime                      @default(now())
  effectiveTo           DateTime?
  creadoEn              DateTime                      @default(now())
  actualizadoEn         DateTime                      @updatedAt

  @@index([branchProfileId, weekday, active])
  @@index([professionalProfileId, weekday, active])
  @@index([resourceId, weekday, active])
}

model SchedulerAvailabilityException {
  id                    String                             @id @default(cuid())
  branchProfileId       String
  branchProfile         SchedulerBranchProfile             @relation(fields: [branchProfileId], references: [id], onDelete: Restrict)
  professionalProfileId String?
  professionalProfile   SchedulerProfessionalProfile?      @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  resourceId            String?
  resource              SchedulerResource?                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  kind                  SchedulerAvailabilityExceptionKind
  date                  DateTime                           @db.Date
  startMinute           Int?
  endMinute             Int?
  reason                String?                            @db.VarChar(500)
  active                Boolean                            @default(true)
  effectiveFrom         DateTime                           @default(now())
  effectiveTo           DateTime?
  creadoEn              DateTime                           @default(now())
  actualizadoEn         DateTime                           @updatedAt

  @@index([branchProfileId, date, active])
  @@index([professionalProfileId, date, active])
  @@index([resourceId, date, active])
}

// ─── Módulo POS: catálogo, clientes, configuración y activos ─────────────────────

enum CatalogItemKind {
  PRODUCT
  SERVICE
  SUPPLY
  MACHINE
  MEMBERSHIP
}

enum PosMembershipStatus {
  PENDING
  ACTIVE
  EXHAUSTED
  CANCELED
}

enum PosMembershipClientProfile {
  POTENTIAL
  LOYAL
  VIP
  RECOVERY
}

enum PosMembershipSignatureStatus {
  PENDING
  SIGNED
  NOT_REQUIRED
}

enum PosAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum PosPriceListStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PosPackageStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum PosCardType {
  CREDIT
  DEBIT
}

enum PosCatalogChangeAction {
  CREATED
  UPDATED
  INACTIVATED
  REACTIVATED
}

enum PosCourtesyProductType {
  FACIAL
  BODY
}

enum PosTicketParticipantKind {
  SELLER
  COMPANY
}

enum PosVoucherKind {
  NEXT_PURCHASE_DISCOUNT
  COMPANION_FACIAL
  MEMBERSHIP_DISCOUNT
}

enum PosCompetitionType {
  AMOUNT
  PRODUCT
  PACKAGE
  PERIOD
}

model CatalogTaxonomy {
  id                String            @id @default(cuid())
  name              String            @db.VarChar(160)
  normalizedName    String            @db.VarChar(180)
  parentId          String?
  parent            CatalogTaxonomy?  @relation("CatalogTaxonomyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          CatalogTaxonomy[] @relation("CatalogTaxonomyTree")
  active            Boolean           @default(true)
  deletedAt         DateTime?
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt
  catalogFamilies   CatalogItem[]     @relation("CatalogItemFamily")
  catalogCategories CatalogItem[]     @relation("CatalogItemCategory")

  @@unique([parentId, normalizedName])
  @@index([parentId, active])
}

model CatalogItem {
  id                       String                         @id @default(cuid())
  sku                      String                         @unique @db.VarChar(96)
  name                     String                         @db.VarChar(240)
  normalizedName           String                         @db.VarChar(260)
  kind                     CatalogItemKind
  familyId                 String?
  family                   CatalogTaxonomy?               @relation("CatalogItemFamily", fields: [familyId], references: [id], onDelete: Restrict)
  categoryId               String?
  category                 CatalogTaxonomy?               @relation("CatalogItemCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  description              String?
  benefits                 CatalogItemBenefit[]
  published                Boolean                        @default(false)
  active                   Boolean                        @default(true)
  deletedAt                DateTime?
  listPrice                Decimal                        @default(0) @db.Decimal(14, 2)
  minimumPrice             Decimal                        @default(0) @db.Decimal(14, 2)
  unitCost                 Decimal                        @default(0) @db.Decimal(14, 2)
  taxRate                  Decimal                        @default(0) @db.Decimal(8, 2)
  supplierId               String?
  supplier                 PosSupplier?                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  assets                   CatalogAsset[]
  branchVisibility         CatalogItemBranchVisibility[]
  priceHistory             CatalogItemPrice[]
  priceListLines           PosPriceListLine[]
  packageLines             PosPackageLine[]
  inventoryBalances        InventoryBalance[]
  inventoryMovementLines   InventoryMovementLine[]
  inventoryAdjustmentLines InventoryAdjustmentBatchLine[]
  inventoryCountLines      InventoryCountLine[]
  warehouseRequestLines    WarehouseRequestLine[]
  posTicketLines           PosTicketLine[]
  posAppointments          PosAppointment[]
  posOwedProducts          PosOwedProduct[]
  posDeliveryLines         PosOwedProductDeliveryLine[]
  membershipTerms          PosMembershipTerms[]
  clientMemberships        PosClientMembership[]
  schedulerServiceProfile  SchedulerServiceProfile?
  creadoEn                 DateTime                       @default(now())
  actualizadoEn            DateTime                       @updatedAt

  @@index([active, published, kind])
  @@index([familyId, categoryId])
  @@index([supplierId])
}

model CatalogItemBenefit {
  id        String      @id @default(cuid())
  itemId    String
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String      @db.VarChar(500)
  sortOrder Int         @default(0)
  creadoEn  DateTime    @default(now())

  @@unique([itemId, sortOrder])
}

model CatalogItemBranchVisibility {
  id            String      @id @default(cuid())
  itemId        String
  item          CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Sucursal    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visible       Boolean     @default(true)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  @@unique([itemId, branchId])
  @@index([branchId, visible])
}

// Nunca se sobrescribe: cada cambio de precio/costo crea una fila nueva.
model CatalogItemPrice {
  id                    String      @id @default(cuid())
  itemId                String
  item                  CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  listPrice             Decimal     @db.Decimal(14, 2)
  minimumPrice          Decimal     @db.Decimal(14, 2)
  unitCost              Decimal     @db.Decimal(14, 2)
  taxRate               Decimal     @db.Decimal(8, 2)
  effectiveAt           DateTime    @default(now())
  createdByCredentialId String?
  creadoEn              DateTime    @default(now())

  @@index([itemId, effectiveAt])
}

model CatalogAsset {
  id                    String         @id @default(cuid())
  itemId                String
  item                  CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storagePath           String         @unique
  publicUrl             String
  fileName              String         @db.VarChar(255)
  mimeType              String         @db.VarChar(100)
  sizeBytes             Int
  isPrimary             Boolean        @default(false)
  status                PosAssetStatus @default(PENDING)
  createdByCredentialId String?
  creadoEn              DateTime       @default(now())
  actualizadoEn         DateTime       @updatedAt

  @@index([itemId, status])
}

model CustomerSource {
  id                    String     @id @default(cuid())
  name                  String     @unique @db.VarChar(160)
  active                Boolean    @default(true)
  companyOwnedByDefault Boolean    @default(false)
  deletedAt             DateTime?
  customers             Customer[]
  creadoEn              DateTime   @default(now())
  actualizadoEn         DateTime   @updatedAt
}

model Customer {
  id                   String                        @id @default(cuid())
  displayName          String                        @db.VarChar(240)
  normalizedName       String                        @db.VarChar(260)
  phone                String?                       @unique @db.VarChar(32)
  email                String?                       @db.VarChar(320)
  externalClientId     String?                       @unique @db.VarChar(160)
  sourceId             String?
  source               CustomerSource?               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  notes                String?
  active               Boolean                       @default(true)
  deletedAt            DateTime?
  portfolios           CustomerPortfolioAssignment[]
  priceListAssignments PriceListCustomerAssignment[]
  warehouseRequests    WarehouseRequest[]
  posTickets           PosTicket[]
  posAppointments      PosAppointment[]
  posVoucherIssues     PosVoucherIssue[]
  posMemberships       PosClientMembership[]
  agendaReservations   AgendaReservation[]
  agendaSyncEvents     AgendaSyncEvent[]
  portfolioTransfers   PosPortfolioTransferEvent[]
  creadoEn             DateTime                      @default(now())
  actualizadoEn        DateTime                      @updatedAt

  @@index([normalizedName, active])
  @@index([sourceId])
}

// Versionar la cartera preserva quién atendía al cliente en cualquier fecha.
model CustomerPortfolioAssignment {
  id                    String                @id @default(cuid())
  customerId            String
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId              String?
  branch                Sucursal?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employeeId            String?
  employee              Empleado?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  companyId             String?
  company               PosCommercialCompany? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ownerNameSnapshot     String?               @db.VarChar(240)
  ownerCodeSnapshot     String?               @db.VarChar(80)
  endedReason           String?               @db.VarChar(120)
  effectiveFrom         DateTime              @default(now())
  effectiveTo           DateTime?
  createdByCredentialId String?
  creadoEn              DateTime              @default(now())

  @@index([customerId, effectiveFrom, effectiveTo])
  @@index([branchId, employeeId])
  @@index([companyId, effectiveTo])
}

model PosCommercialCompany {
  id                    String                        @id @default(cuid())
  salesNumber           String                        @unique @db.VarChar(80)
  name                  String                        @db.VarChar(160)
  active                Boolean                       @default(true)
  version               Int                           @default(1)
  updatedByCredentialId String?
  portfolios            CustomerPortfolioAssignment[]
  ticketParticipants    PosTicketParticipant[]
  portfolioTransfers    PosPortfolioTransferEvent[]
  creadoEn              DateTime                      @default(now())
  actualizadoEn         DateTime                      @updatedAt
}

model PosPortfolioTransferEvent {
  id                    String               @id @default(uuid()) @db.Uuid
  customerId            String
  customer              Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId              String?
  branch                Sucursal?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sellerId              String
  seller                Empleado             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerNameSnapshot    String               @db.VarChar(240)
  companyId             String
  company               PosCommercialCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyNameSnapshot   String               @db.VarChar(160)
  companyNumberSnapshot String               @db.VarChar(80)
  reason                String               @db.VarChar(120)
  actorCredentialId     String
  actorCredential       PosCredential        @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  transferredAt         DateTime             @default(now())

  @@index([customerId, transferredAt])
  @@index([sellerId, transferredAt])
}

model PosBank {
  id                    String          @id
  name                  String          @db.VarChar(200)
  normalizedName        String          @unique @db.VarChar(220)
  active                Boolean         @default(true)
  version               Int             @default(1)
  sourceName            String          @db.VarChar(120)
  sourceReviewedAt      DateTime        @db.Date
  createdByCredentialId String?
  payments              PosPayment[]
  changes               PosBankChange[]
  creadoEn              DateTime        @default(now())
  actualizadoEn         DateTime        @updatedAt

  @@index([active, name])
}

model PosBankChange {
  id                String                 @id @default(uuid()) @db.Uuid
  bankId            String
  bank              PosBank                @relation(fields: [bankId], references: [id], onDelete: Restrict)
  action            PosCatalogChangeAction
  version           Int
  previousSnapshot  Json?
  nextSnapshot      Json
  actorCredentialId String?
  actorCredential   PosCredential?         @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  cambiadoEn        DateTime               @default(now())

  @@unique([bankId, version])
}

model PosCardNetwork {
  id                    String                 @id
  name                  String                 @db.VarChar(120)
  normalizedName        String                 @unique @db.VarChar(140)
  active                Boolean                @default(true)
  version               Int                    @default(1)
  sourceName            String                 @db.VarChar(120)
  sourceReviewedAt      DateTime               @db.Date
  createdByCredentialId String?
  payments              PosPayment[]
  changes               PosCardNetworkChange[]
  creadoEn              DateTime               @default(now())
  actualizadoEn         DateTime               @updatedAt
}

model PosCardNetworkChange {
  id                String                 @id @default(uuid()) @db.Uuid
  networkId         String
  network           PosCardNetwork         @relation(fields: [networkId], references: [id], onDelete: Restrict)
  action            PosCatalogChangeAction
  version           Int
  previousSnapshot  Json?
  nextSnapshot      Json
  actorCredentialId String?
  actorCredential   PosCredential?         @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  cambiadoEn        DateTime               @default(now())

  @@unique([networkId, version])
}

model PosInstallmentOption {
  id                    String                       @id
  months                Int                          @unique
  label                 String                       @db.VarChar(120)
  active                Boolean                      @default(true)
  version               Int                          @default(1)
  sourceName            String                       @db.VarChar(120)
  sourceReviewedAt      DateTime                     @db.Date
  createdByCredentialId String?
  changes               PosInstallmentOptionChange[]
  creadoEn              DateTime                     @default(now())
  actualizadoEn         DateTime                     @updatedAt
}

model PosInstallmentOptionChange {
  id                String                 @id @default(uuid()) @db.Uuid
  optionId          String
  option            PosInstallmentOption   @relation(fields: [optionId], references: [id], onDelete: Restrict)
  action            PosCatalogChangeAction
  version           Int
  previousSnapshot  Json?
  nextSnapshot      Json
  actorCredentialId String?
  actorCredential   PosCredential?         @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  cambiadoEn        DateTime               @default(now())

  @@unique([optionId, version])
}

model PosCourtesyProduct {
  id                    String                      @id @default(cuid())
  name                  String                      @db.VarChar(160)
  normalizedName        String                      @unique @db.VarChar(180)
  type                  PosCourtesyProductType
  active                Boolean                     @default(true)
  version               Int                         @default(1)
  createdByCredentialId String?
  packageLines          PosCourtesyPackageLine[]
  ticketCourtesies      PosCourtesy[]
  versions              PosCourtesyProductVersion[]
  creadoEn              DateTime                    @default(now())
  actualizadoEn         DateTime                    @updatedAt
}

model PosCourtesyProductVersion {
  id                String                 @id @default(uuid()) @db.Uuid
  productId         String
  product           PosCourtesyProduct     @relation(fields: [productId], references: [id], onDelete: Restrict)
  version           Int
  nameSnapshot      String                 @db.VarChar(160)
  typeSnapshot      PosCourtesyProductType
  activeSnapshot    Boolean
  actorCredentialId String?
  actorCredential   PosCredential?         @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  creadoEn          DateTime               @default(now())

  @@unique([productId, version])
}

model PosCourtesyPackage {
  id                    String                             @id @default(cuid())
  name                  String                             @db.VarChar(160)
  normalizedName        String                             @unique @db.VarChar(180)
  active                Boolean                            @default(true)
  version               Int                                @default(1)
  createdByCredentialId String?
  lines                 PosCourtesyPackageLine[]
  ticketCourtesies      PosCourtesy[]
  versions              PosCourtesyPackageVersion[]
  checkoutDefaults      PosCourtesyCheckoutConfiguration[]
  creadoEn              DateTime                           @default(now())
  actualizadoEn         DateTime                           @updatedAt
}

model PosCourtesyPackageLine {
  id        String             @id @default(cuid())
  packageId String
  package   PosCourtesyPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product   PosCourtesyProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  sortOrder Int

  @@unique([packageId, sortOrder])
}

model PosCourtesyPackageVersion {
  id                String             @id @default(uuid()) @db.Uuid
  packageId         String
  package           PosCourtesyPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  version           Int
  nameSnapshot      String             @db.VarChar(160)
  activeSnapshot    Boolean
  linesSnapshot     Json
  actorCredentialId String?
  actorCredential   PosCredential?     @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  creadoEn          DateTime           @default(now())

  @@unique([packageId, version])
}

model PosCourtesyCheckoutConfiguration {
  id                    String              @id @default(cuid())
  branchId              String?             @unique
  required              Boolean             @default(false)
  defaultPackageId      String?
  defaultPackage        PosCourtesyPackage? @relation(fields: [defaultPackageId], references: [id], onDelete: Restrict)
  defaultPackageVersion Int?
  updatedByCredentialId String?
  creadoEn              DateTime            @default(now())
  actualizadoEn         DateTime            @updatedAt
}

model PosPaymentMethodPolicy {
  id                String     @id @default(cuid())
  paymentMethodId   String     @unique
  paymentMethod     MetodoPago @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  requiresReference Boolean    @default(false)
  referenceLabel    String?    @db.VarChar(80)
  minAmount         Decimal?   @db.Decimal(14, 2)
  maxAmount         Decimal?   @db.Decimal(14, 2)
  activeForPos      Boolean    @default(true)
  creadoEn          DateTime   @default(now())
  actualizadoEn     DateTime   @updatedAt
}

model PosTicketConfiguration {
  id                       String   @id @default(cuid())
  branchId                 String?  @unique
  logoAssetId              String?
  companyName              String   @default("KEYSAR COSMETICS") @db.VarChar(160)
  address                  String?
  footerMessage            String?
  policies                 String?
  showClientName           Boolean  @default(true)
  showClientPhone          Boolean  @default(true)
  showSellerName           Boolean  @default(true)
  showVatBreakdown         Boolean  @default(true)
  showSpareCoverageMessage Boolean  @default(true)
  creadoEn                 DateTime @default(now())
  actualizadoEn            DateTime @updatedAt
}

model PosCustomerRequiredField {
  id            String   @id @default(cuid())
  key           String   @unique @db.VarChar(80)
  label         String   @db.VarChar(120)
  required      Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model PosCourtesyPolicy {
  id                    String    @id @default(cuid())
  name                  String    @unique @db.VarChar(160)
  description           String?
  requiresCustomer      Boolean   @default(true)
  requiresAuthorization Boolean   @default(true)
  active                Boolean   @default(true)
  deletedAt             DateTime?
  creadoEn              DateTime  @default(now())
  actualizadoEn         DateTime  @updatedAt
}

model PosVoucherTemplate {
  id               String            @id @default(cuid())
  name             String            @unique @db.VarChar(160)
  kind             PosVoucherKind
  value            Decimal           @db.Decimal(14, 2)
  message          String            @db.VarChar(1000)
  active           Boolean           @default(true)
  visibleToSellers Boolean           @default(false)
  deletedAt        DateTime?
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt
  issues           PosVoucherIssue[]
}

model PosSupplier {
  id                String             @id @default(cuid())
  folio             String             @unique @db.VarChar(64)
  businessName      String             @db.VarChar(240)
  normalizedName    String             @unique @db.VarChar(260)
  contactName       String?
  rfc               String?            @db.VarChar(20)
  taxRegime         String?
  businessLine      String?
  phone             String?
  email             String?
  address           String?
  active            Boolean            @default(true)
  deletedAt         DateTime?
  catalogItems      CatalogItem[]
  priceLists        PosPriceList[]
  warehouseRequests WarehouseRequest[]
  creadoEn          DateTime           @default(now())
  actualizadoEn     DateTime           @updatedAt

  @@index([active, normalizedName])
}

model PosPriceList {
  id                  String                        @id @default(cuid())
  name                String                        @db.VarChar(160)
  version             Int                           @default(1)
  status              PosPriceListStatus            @default(DRAFT)
  supplierId          String?
  supplier            PosSupplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  lines               PosPriceListLine[]
  branchAssignments   PriceListBranchAssignment[]
  customerAssignments PriceListCustomerAssignment[]
  warehouseRequests   WarehouseRequest[]
  deletedAt           DateTime?
  creadoEn            DateTime                      @default(now())
  actualizadoEn       DateTime                      @updatedAt

  @@unique([name, version])
  @@index([status, effectiveFrom, effectiveTo])
}

model PosPriceListLine {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PosPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId      String
  item        CatalogItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  price       Decimal      @db.Decimal(14, 2)
  cost        Decimal?     @db.Decimal(14, 2)
  creadoEn    DateTime     @default(now())

  @@unique([priceListId, itemId])
}

model PriceListBranchAssignment {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PosPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Sucursal     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([priceListId, branchId])
}

model PriceListCustomerAssignment {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PosPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([priceListId, customerId])
}

model PosPackage {
  id            String           @id @default(cuid())
  name          String           @db.VarChar(160)
  sku           String           @unique @db.VarChar(96)
  description   String?
  price         Decimal          @db.Decimal(14, 2)
  status        PosPackageStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  lines         PosPackageLine[]
  deletedAt     DateTime?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  ticketLines   PosTicketLine[]

  @@index([status, startsAt, endsAt])
}

model PosPackageLine {
  id        String      @id @default(cuid())
  packageId String
  package   PosPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  itemId    String
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Decimal     @db.Decimal(14, 2)

  @@unique([packageId, itemId])
}

model PosSalesCompetition {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(160)
  type           PosCompetitionType
  active         Boolean            @default(true)
  dateFrom       DateTime           @db.Date
  dateTo         DateTime           @db.Date
  branchId       String?
  branch         Sucursal?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  targetAmount   Decimal?           @db.Decimal(14, 2)
  itemId         String?
  packageItemIds Json?
  deletedAt      DateTime?
  creadoEn       DateTime           @default(now())
  actualizadoEn  DateTime           @updatedAt

  @@index([active, dateFrom, dateTo])
  @@index([branchId])
}

// ─── Módulo POS: inventario, conteos y bodega matriz ──────────────────

enum InventoryLocationType {
  BRANCH
  WAREHOUSE
}

enum InventoryMovementType {
  ADD
  REMOVE
  TRANSFER
  RETURN
  DEMO
  WRITE_OFF
  REVERSAL
  COUNT_ADJUSTMENT
  WAREHOUSE_SHIPMENT
  WAREHOUSE_RECEIPT
  SUPPLIER_RECEIPT
}

enum InventoryMovementStatus {
  APPLIED
  REVERSED
}

enum InventoryAdjustmentBatchStatus {
  PENDING
  APPLIED
  CANCELED
  REVERSED
}

enum InventoryCountKind {
  OPENING
  CLOSING
}

enum WarehouseRequestType {
  PRODUCT
  TESTER
  SUPPLY
}

enum WarehouseRequestSource {
  BRANCH
  SUPPLIER
}

enum WarehouseRequestStatus {
  REQUESTED
  CREATION_APPROVED
  SEND_APPROVED
  SHIPPED
  RECEIVED
  CANCELED
}

enum PosNotificationKind {
  WAREHOUSE_REQUESTED
  WAREHOUSE_CREATION_APPROVED
  WAREHOUSE_SHIPPED
  WAREHOUSE_RECEIVED
  WAREHOUSE_RETURNED
  WAREHOUSE_CANCELED
  SALE_COMPLETED
  CASH_EXPENSE
  PRODUCT_CREATED
  INVENTORY_ADD
  INVENTORY_REMOVE
  INVENTORY_TRANSFER
  CLOSE_DAY
  CLOCK_IN
}

enum PosNotificationAccess {
  VIEW
  EDIT
}

model PosIdempotencyRecord {
  id                String   @id @default(cuid())
  key               String   @unique @db.Uuid
  actorCredentialId String
  operation         String   @db.VarChar(120)
  requestHash       String   @db.VarChar(64)
  responseStatus    Int
  responseBody      Json
  creadoEn          DateTime @default(now())

  @@index([actorCredentialId, creadoEn])
}

model InventoryLocation {
  id                    String                         @id @default(cuid())
  code                  String                         @unique @db.VarChar(64)
  name                  String                         @db.VarChar(160)
  type                  InventoryLocationType
  branchId              String?                        @unique
  branch                Sucursal?                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  active                Boolean                        @default(true)
  balances              InventoryBalance[]
  movementsFrom         InventoryMovementLine[]        @relation("InventoryMovementFrom")
  movementsTo           InventoryMovementLine[]        @relation("InventoryMovementTo")
  adjustmentFrom        InventoryAdjustmentBatchLine[] @relation("InventoryAdjustmentFrom")
  adjustmentTo          InventoryAdjustmentBatchLine[] @relation("InventoryAdjustmentTo")
  counts                InventoryCount[]
  warehouseSources      WarehouseRequest[]             @relation("WarehouseRequestSourceLocation")
  warehouseDestinations WarehouseRequest[]             @relation("WarehouseRequestDestinationLocation")
  creadoEn              DateTime                       @default(now())
  actualizadoEn         DateTime                       @updatedAt

  @@index([type, active])
}

model InventoryBalance {
  id                String            @id @default(cuid())
  locationId        String
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemId            String
  item              CatalogItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  availableQuantity Decimal           @default(0) @db.Decimal(14, 2)
  reservedQuantity  Decimal           @default(0) @db.Decimal(14, 2)
  version           Int               @default(0)
  actualizadoEn     DateTime          @updatedAt

  @@unique([locationId, itemId])
  @@index([itemId])
}

model InventoryMovement {
  id                 String                    @id @default(cuid())
  folio              String                    @unique @db.VarChar(64)
  type               InventoryMovementType
  status             InventoryMovementStatus   @default(APPLIED)
  reason             String?                   @db.VarChar(240)
  notes              String?                   @db.VarChar(1000)
  businessDate       DateTime                  @db.Date
  actorCredentialId  String
  actorCredential    PosCredential             @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  terminalId         String
  terminal           PosTerminal               @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  adjustmentBatchId  String?                   @unique
  adjustmentBatch    InventoryAdjustmentBatch? @relation(fields: [adjustmentBatchId], references: [id], onDelete: Restrict)
  warehouseRequestId String?
  warehouseRequest   WarehouseRequest?         @relation(fields: [warehouseRequestId], references: [id], onDelete: Restrict)
  countId            String?                   @unique
  count              InventoryCount?           @relation(fields: [countId], references: [id], onDelete: Restrict)
  reversalOfId       String?                   @unique
  reversalOf         InventoryMovement?        @relation("InventoryMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         InventoryMovement?        @relation("InventoryMovementReversal")
  lines              InventoryMovementLine[]
  creadoEn           DateTime                  @default(now())
  ticket             PosTicket?
  delivery           PosOwedProductDelivery?
  ticketEvent        PosTicketEvent?

  @@index([businessDate, creadoEn])
  @@index([adjustmentBatchId])
  @@index([warehouseRequestId])
}

model InventoryMovementLine {
  id                 String             @id @default(cuid())
  movementId         String
  movement           InventoryMovement  @relation(fields: [movementId], references: [id], onDelete: Restrict)
  itemId             String
  item               CatalogItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLocationId     String?
  fromLocation       InventoryLocation? @relation("InventoryMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId       String?
  toLocation         InventoryLocation? @relation("InventoryMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  quantity           Decimal            @db.Decimal(14, 2)
  fromQuantityBefore Decimal?           @db.Decimal(14, 2)
  fromQuantityAfter  Decimal?           @db.Decimal(14, 2)
  toQuantityBefore   Decimal?           @db.Decimal(14, 2)
  toQuantityAfter    Decimal?           @db.Decimal(14, 2)
  unitCostSnapshot   Decimal?           @db.Decimal(14, 2)
  metadata           Json?
  creadoEn           DateTime           @default(now())

  @@index([itemId, creadoEn])
  @@index([fromLocationId, creadoEn])
  @@index([toLocationId, creadoEn])
}

model InventoryAdjustmentBatch {
  id                     String                         @id @default(cuid())
  folio                  String                         @unique @db.VarChar(64)
  status                 InventoryAdjustmentBatchStatus @default(PENDING)
  notes                  String?                        @db.VarChar(1000)
  createdByCredentialId  String
  createdByCredential    PosCredential                  @relation("InventoryBatchCreated", fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  resolvedByCredentialId String?
  resolvedByCredential   PosCredential?                 @relation("InventoryBatchResolved", fields: [resolvedByCredentialId], references: [id], onDelete: Restrict)
  resolvedAt             DateTime?
  lines                  InventoryAdjustmentBatchLine[]
  movement               InventoryMovement?
  creadoEn               DateTime                       @default(now())
  actualizadoEn          DateTime                       @updatedAt

  @@index([status, creadoEn])
}

model InventoryAdjustmentBatchLine {
  id             String                   @id @default(cuid())
  batchId        String
  batch          InventoryAdjustmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId         String
  item           CatalogItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type           InventoryMovementType
  fromLocationId String?
  fromLocation   InventoryLocation?       @relation("InventoryAdjustmentFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String?
  toLocation     InventoryLocation?       @relation("InventoryAdjustmentTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  quantity       Decimal                  @db.Decimal(14, 2)
  reason         String?                  @db.VarChar(240)
  notes          String?                  @db.VarChar(1000)
  creadoEn       DateTime                 @default(now())

  @@index([batchId])
}

model InventoryCount {
  id                    String               @id @default(cuid())
  kind                  InventoryCountKind
  businessDate          DateTime             @db.Date
  locationId            String
  location              InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  notes                 String?              @db.VarChar(500)
  createdByCredentialId String
  createdByCredential   PosCredential        @relation(fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  terminalId            String
  terminal              PosTerminal          @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  lines                 InventoryCountLine[]
  movement              InventoryMovement?
  creadoEn              DateTime             @default(now())
  openingBusinessDay    PosBusinessDay?      @relation("PosBusinessDayOpeningCount")
  closingBusinessDay    PosBusinessDay?      @relation("PosBusinessDayClosingCount")

  @@unique([locationId, businessDate, kind])
  @@index([businessDate, kind])
}

model InventoryCountLine {
  id                 String         @id @default(cuid())
  countId            String
  count              InventoryCount @relation(fields: [countId], references: [id], onDelete: Restrict)
  itemId             String
  item               CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  countedQuantity    Decimal        @db.Decimal(14, 2)
  expectedQuantity   Decimal        @db.Decimal(14, 2)
  differenceQuantity Decimal        @db.Decimal(14, 2)
  unitCostSnapshot   Decimal?       @db.Decimal(14, 2)
  matchesExpected    Boolean

  @@unique([countId, itemId])
}

model WarehouseRequest {
  id                             String                  @id @default(cuid())
  folio                          String                  @unique @db.VarChar(64)
  source                         WarehouseRequestSource
  requestType                    WarehouseRequestType
  status                         WarehouseRequestStatus  @default(REQUESTED)
  branchId                       String?
  branch                         Sucursal?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId                     String?
  supplier                       PosSupplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  priceListId                    String?
  priceList                      PosPriceList?           @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  customerId                     String?
  customer                       Customer?               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceLocationId               String?
  sourceLocation                 InventoryLocation?      @relation("WarehouseRequestSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocationId          String
  destinationLocation            InventoryLocation       @relation("WarehouseRequestDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  notes                          String?                 @db.VarChar(1000)
  createdByCredentialId          String
  createdByCredential            PosCredential           @relation("WarehouseRequestCreated", fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  creationApprovedByCredentialId String?
  creationApprovedByCredential   PosCredential?          @relation("WarehouseRequestCreationApproved", fields: [creationApprovedByCredentialId], references: [id], onDelete: Restrict)
  creationApprovedAt             DateTime?
  sendApprovedByCredentialId     String?
  sendApprovedByCredential       PosCredential?          @relation("WarehouseRequestSendApproved", fields: [sendApprovedByCredentialId], references: [id], onDelete: Restrict)
  sendApprovedAt                 DateTime?
  shippedAt                      DateTime?
  receivedByCredentialId         String?
  receivedByCredential           PosCredential?          @relation("WarehouseRequestReceived", fields: [receivedByCredentialId], references: [id], onDelete: Restrict)
  receivedAt                     DateTime?
  canceledByCredentialId         String?
  canceledByCredential           PosCredential?          @relation("WarehouseRequestCanceled", fields: [canceledByCredentialId], references: [id], onDelete: Restrict)
  canceledAt                     DateTime?
  lines                          WarehouseRequestLine[]
  events                         WarehouseRequestEvent[]
  movements                      InventoryMovement[]
  notifications                  PosNotification[]
  creadoEn                       DateTime                @default(now())
  actualizadoEn                  DateTime                @updatedAt

  @@index([status, creadoEn])
  @@index([branchId, status])
  @@index([supplierId, status])
}

model WarehouseRequestLine {
  id                    String           @id @default(cuid())
  requestId             String
  request               WarehouseRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  itemId                String
  item                  CatalogItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity              Decimal          @db.Decimal(14, 2)
  itemNameSnapshot      String           @db.VarChar(240)
  skuSnapshot           String           @db.VarChar(96)
  unitCostSnapshot      Decimal?         @db.Decimal(14, 2)
  priceSnapshot         Decimal?         @db.Decimal(14, 2)
  priceListNameSnapshot String?          @db.VarChar(160)
  customerNameSnapshot  String?          @db.VarChar(240)

  @@unique([requestId, itemId])
}

model WarehouseRequestEvent {
  id                String                  @id @default(cuid())
  requestId         String
  request           WarehouseRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  fromStatus        WarehouseRequestStatus?
  toStatus          WarehouseRequestStatus
  action            String                  @db.VarChar(80)
  actorCredentialId String
  actorCredential   PosCredential           @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  notes             String?                 @db.VarChar(1000)
  creadoEn          DateTime                @default(now())

  @@index([requestId, creadoEn])
}

model PosNotification {
  id                    String                  @id @default(cuid())
  kind                  PosNotificationKind
  title                 String                  @db.VarChar(240)
  message               String                  @db.VarChar(1000)
  branchId              String?
  branch                Sucursal?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  audiencePermission    String?                 @db.VarChar(80)
  warehouseRequestId    String?
  warehouseRequest      WarehouseRequest?       @relation(fields: [warehouseRequestId], references: [id], onDelete: SetNull)
  createdByCredentialId String?
  createdByCredential   PosCredential?          @relation(fields: [createdByCredentialId], references: [id], onDelete: SetNull)
  sourceType            String?                 @db.VarChar(80)
  sourceId              String?                 @db.VarChar(120)
  outbox                PosNotificationOutbox[]
  reads                 PosNotificationRead[]
  creadoEn              DateTime                @default(now())

  @@unique([kind, sourceType, sourceId])
  @@index([branchId, creadoEn])
  @@index([audiencePermission, creadoEn])
  @@index([sourceType, sourceId])
}

model PosNotificationPreference {
  id            String                @id @default(cuid())
  kind          PosNotificationKind
  credentialId  String
  credential    PosCredential         @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  access        PosNotificationAccess @default(VIEW)
  active        Boolean               @default(true)
  creadoEn      DateTime              @default(now())
  actualizadoEn DateTime              @updatedAt

  @@unique([kind, credentialId])
  @@index([credentialId, active])
}

model PosNotificationOutbox {
  id             String                @id @default(cuid())
  notificationId String
  notification   PosNotification       @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  credentialId   String
  credential     PosCredential         @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  access         PosNotificationAccess @default(VIEW)
  deliveredAt    DateTime?
  creadoEn       DateTime              @default(now())

  @@unique([notificationId, credentialId])
  @@index([credentialId, deliveredAt, creadoEn])
}

model PosNotificationRead {
  id             String          @id @default(cuid())
  notificationId String
  notification   PosNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  credentialId   String
  credential     PosCredential   @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  readAt         DateTime        @default(now())

  @@unique([notificationId, credentialId])
  @@index([credentialId, readAt])
}

