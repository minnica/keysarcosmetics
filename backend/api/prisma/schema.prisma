generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  SUPER_ADMIN
  GERENTE
  CAPTURISTA
}

model Usuario {
  id                          String         @id @default(cuid())
  nombre                      String
  email                       String         @unique
  passwordHash                String
  rol                         Rol
  activo                      Boolean        @default(true)
  sucursalId                  String?
  sucursal                    Sucursal?      @relation(fields: [sucursalId], references: [id])
  empleadoId                  String?        @unique
  empleado                    Empleado?      @relation(fields: [empleadoId], references: [id])
  registrosCitaCreados        RegistroCita[]
  passwordChangedAt           DateTime?
  passwordSetupTokenHash      String?
  passwordSetupTokenExpiresAt DateTime?
  creadoEn                    DateTime       @default(now())
  actualizadoEn               DateTime       @updatedAt
}

model Sucursal {
  id            String         @id @default(cuid())
  nombre        String
  activa        Boolean        @default(true)
  usuarios      Usuario[]
  ventas        Venta[]
  registrosCita RegistroCita[]
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
}

model CategoriaAtencion {
  id             String                 @id @default(cuid())
  nombre         String                 @unique
  activa         Boolean                @default(true)
  subcategorias  SubcategoriaAtencion[]
  creadoEn       DateTime               @default(now())
  actualizadoEn  DateTime               @updatedAt
}

model SubcategoriaAtencion {
  id             String            @id @default(cuid())
  nombre         String
  activa         Boolean           @default(true)
  categoriaId    String
  categoria      CategoriaAtencion @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  registrosCita  RegistroCita[]
  creadoEn       DateTime          @default(now())
  actualizadoEn  DateTime          @updatedAt

  @@unique([categoriaId, nombre])
  @@index([categoriaId, activa])
}

// ─── Módulo Envelope ──────────────────────────────────────────────────────────

enum MetodoPagoTipo {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

model MetodoPago {
  id            String         @id @default(cuid())
  nombre        String
  tipo          MetodoPagoTipo
  activo        Boolean        @default(true)
  detalles      VentaDetalle[]
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
}

model Bank {
  id            String     @id @default(cuid())
  nombre        String     @unique
  activo        Boolean    @default(true)
  empleados     Empleado[]
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
}

model Position {
  id                String                     @id @default(cuid())
  nombre            String                     @unique
  activo            Boolean                    @default(true)
  canManageAccess   Boolean                    @default(false)
  selfDataOnly      Boolean                    @default(false)
  empleados         Empleado[]
  screenPermissions PositionScreenPermission[]
  creadoEn          DateTime                   @default(now())
  actualizadoEn     DateTime                   @updatedAt
}

model PositionScreenPermission {
  id            String   @id @default(cuid())
  positionId    String
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  screenKey     String
  allowed       Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([positionId, screenKey])
}

model Empleado {
  id                  String         @id @default(cuid())
  nombres             String
  apellidoPaterno     String
  apellidoMaterno     String
  nombreCompleto      String
  // Campos legacy — se eliminan en Fase 4 tras backfill completo en producción
  banco               String
  numeroCuenta        String
  puesto              String
  sueldo              Decimal?       @db.Decimal(10, 2)
  fechaNacimiento     DateTime?
  numeroTelefono      String?
  // FK a catálogos dinámicos — nullable durante transición
  bankId              String?
  bank                Bank?          @relation(fields: [bankId], references: [id])
  positionId          String?
  position            Position?      @relation(fields: [positionId], references: [id])
  usuario             Usuario?
  metaIndividual      Decimal        @db.Decimal(10, 2)
  activo              Boolean        @default(true)
  ventas              Venta[]
  citasComoVendedor   RegistroCita[] @relation("RegistroCitaVendedor")
  citasComoFacialista RegistroCita[] @relation("RegistroCitaFacialista")
  creadoEn            DateTime       @default(now())
  actualizadoEn       DateTime       @updatedAt
}

enum TipoCompraCita {
  PAGO_NETO
  COMPRA_CON_APARTADO
  PAGO_DE_APARTADO
}

enum EstatusCita {
  ATENDIDA
  NO_LLEGO
  CANCELADA
}

// Registro operativo de una cita atendida; más adelante podrá vincularse con Scheduler.
model RegistroCita {
  id              String           @id @default(cuid())
  fecha           DateTime
  hora            String?          @db.VarChar(5)
  subcategoriaId  String
  subcategoria    SubcategoriaAtencion @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  estatus         EstatusCita      @default(ATENDIDA)
  nombreCliente   String
  sucursalId      String
  sucursal        Sucursal         @relation(fields: [sucursalId], references: [id])
  vendedorId      String
  vendedor        Empleado         @relation("RegistroCitaVendedor", fields: [vendedorId], references: [id])
  facialistaId    String
  facialista      Empleado         @relation("RegistroCitaFacialista", fields: [facialistaId], references: [id])
  tipoCompra      TipoCompraCita?
  montoCompra     Decimal          @default(0) @db.Decimal(10, 2)
  bonoSalidaTarde Boolean          @default(false)
  bonoComida      Boolean          @default(false)
  creadoPorId     String
  creadoPor       Usuario          @relation(fields: [creadoPorId], references: [id])
  creadoEn        DateTime         @default(now())
  actualizadoEn   DateTime         @updatedAt

  @@index([fecha])
  @@index([estatus, fecha])
  @@index([sucursalId, fecha])
  @@index([facialistaId, fecha])
  @@index([vendedorId, fecha])
  @@index([creadoPorId])
  @@index([subcategoriaId])
}

// Agrupa todas las ventas de un vendedor en un día
model Venta {
  id            String         @id @default(cuid())
  fecha         DateTime
  notas         String?
  // Vincula registros guardados juntos (mismo voucher multi-vendedor); nullable = venta individual
  sesionId      String?
  sucursalId    String
  sucursal      Sucursal       @relation(fields: [sucursalId], references: [id])
  vendedorId    String
  vendedor      Empleado       @relation(fields: [vendedorId], references: [id])
  detalles      VentaDetalle[]
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  @@index([fecha])
  @@index([sucursalId, fecha])
  @@index([vendedorId, fecha])
  @@index([sesionId])
}

// Cada fila = una venta individual con monto y método de pago
model VentaDetalle {
  id            String     @id @default(cuid())
  cantidad      Decimal    @db.Decimal(10, 2)
  ventaId       String
  venta         Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodoPagoId  String
  metodoPago    MetodoPago @relation(fields: [metodoPagoId], references: [id])
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@index([ventaId])
  @@index([metodoPagoId])
}
