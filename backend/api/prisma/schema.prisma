model PosTicket {
  id                    String                 @id @default(uuid()) @db.Uuid
  folio                 String                 @unique @db.VarChar(80)
  terminalSequence      BigInt
  status                PosTicketStatus
  settlementStatus      PosSettlementStatus
  businessDate          DateTime               @db.Date
  branchId              String
  branch                Sucursal               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  terminalId            String
  terminal              PosTerminal            @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  createdByCredentialId String
  createdByCredential   PosCredential          @relation(fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  customerId            String?
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerNameSnapshot  String?                @db.VarChar(240)
  customerPhoneSnapshot String?                @db.VarChar(32)
  subtotal              Decimal                @db.Decimal(14, 2)
  minimumTotal          Decimal                @db.Decimal(14, 2)
  spareTotal            Decimal                @db.Decimal(14, 2)
  discountTotal         Decimal                @db.Decimal(14, 2)
  taxTotal              Decimal                @db.Decimal(14, 2)
  total                 Decimal                @db.Decimal(14, 2)
  amountPaid            Decimal                @db.Decimal(14, 2)
  pendingAmount         Decimal                @db.Decimal(14, 2)
  authorizationId       String?
  inventoryMovementId   String?                @unique
  inventoryMovement     InventoryMovement?     @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  version               Int                    @default(1)
  lines                 PosTicketLine[]
  sellers               PosTicketSeller[]
  participants          PosTicketParticipant[]
  paymentOperations     PosPaymentOperation[]
  events                PosTicketEvent[]
  appointments          PosAppointment[]
  courtesies            PosCourtesy[]
  layaway               PosLayaway?
  owedProducts          PosOwedProduct[]
  voucherIssues         PosVoucherIssue[]
  clientMemberships     PosClientMembership[]
  agendaReservations    AgendaReservation[]
  creadoEn              DateTime               @default(now())

  @@unique([terminalId, terminalSequence])
  @@index([branchId, businessDate, creadoEn])
  @@index([customerId, creadoEn])
  @@index([createdByCredentialId, creadoEn])
}

model PosTicketLine {
