  active                  Boolean                                  @default(true)
  effectiveFrom           DateTime                                 @default(now())
  effectiveTo             DateTime?
  deactivatedAt           DateTime?
  version                 Int                                      @default(1)
  branchAssignments       SchedulerServiceBranchAssignment[]
  professionalAssignments SchedulerProfessionalServiceAssignment[]
  resourceRequirements    SchedulerServiceResourceRequirement[]
