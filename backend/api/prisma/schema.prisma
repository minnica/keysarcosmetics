generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  SUPER_ADMIN
  GERENTE
  CAPTURISTA
}

enum PosTerminalStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Usuario {
  id                                      String                            @id @default(cuid())
  nombre                                  String
  email                                   String                            @unique
  passwordHash                            String
  rol                                     Rol
  activo                                  Boolean                           @default(true)
  sucursalId                              String?
  sucursal                                Sucursal?                         @relation(fields: [sucursalId], references: [id])
  empleadoId                              String?                           @unique
  empleado                                Empleado?                         @relation(fields: [empleadoId], references: [id])
  registrosCitaCreados                    RegistroCita[]
  passwordChangedAt                       DateTime?
  passwordSetupTokenHash                  String?
  passwordSetupTokenExpiresAt             DateTime?
  creadoEn                                DateTime                          @default(now())
  actualizadoEn                           DateTime                          @updatedAt
  payrollRunsCreated                      PayrollRun[]                      @relation("PayrollRunCreatedBy")
  payrollRunsApproved                     PayrollRun[]                      @relation("PayrollRunApprovedBy")
  payrollRunsPaid                         PayrollRun[]                      @relation("PayrollRunPaidBy")
  payrollCatalogItemsCreated              PayrollCatalogItem[]              @relation("PayrollCatalogItemCreatedBy")
  payrollSchemeVersionsCreated            CommissionSchemeVersion[]         @relation("CommissionSchemeVersionCreatedBy")
  payrollAssignmentsCreated               EmployeeCommissionAssignment[]    @relation("EmployeeCommissionAssignmentCreatedBy")
  payrollMovementsCreated                 PayrollMovement[]                 @relation("PayrollMovementCreatedBy")
  payrollMovementsReviewed                PayrollMovement[]                 @relation("PayrollMovementReviewedBy")
  payrollExpensesCreated                  PayrollExpense[]                  @relation("PayrollExpenseCreatedBy")
  payrollExpenseRecurrencesCreated        PayrollExpenseRecurrence[]        @relation("PayrollExpenseRecurrenceCreatedBy")
  payrollExpenseRecurrenceVersionsCreated PayrollExpenseRecurrenceVersion[] @relation("PayrollExpenseRecurrenceVersionCreatedBy")
  payrollExpenseCategoriesCreated         PayrollExpenseCategory[]          @relation("PayrollExpenseCategoryCreatedBy")
  payrollLoansCreated                     LoanAdvance[]                     @relation("LoanAdvanceCreatedBy")
  payrollReceiptsSent                     PayrollReceipt[]                  @relation("PayrollReceiptSentBy")
  payrollReceiptsConfirmed                PayrollReceipt[]                  @relation("PayrollReceiptConfirmedBy")
  payrollAuditEvents                      PayrollAuditEvent[]
  posCredentials                          PosCredential[]
  schedulerSecondaryCredential            SchedulerSecondaryCredential?
  schedulerAuthorizations                 SchedulerAuthorization[]
  schedulerAuditLogs                      AuditLog[]                        @relation("SchedulerAuditActor")
}

model Sucursal {
  id                               String                              @id @default(cuid())
  nombre                           String
  metaMensual                      Decimal                             @default(0) @db.Decimal(14, 2)
  activa                           Boolean                             @default(true)
  desactivadaEn                    DateTime?
  usuarios                         Usuario[]
  empleados                        Empleado[]
  ventas                           Venta[]
  registrosCita                    RegistroCita[]
  creadoEn                         DateTime                            @default(now())
  actualizadoEn                    DateTime                            @updatedAt
  payrollMovementAllocations       PayrollMovementAllocation[]
  payrollExpenses                  PayrollExpense[]
  payrollExpenseRecurrenceVersions PayrollExpenseRecurrenceVersion[]
  payrollRunBranchLines            PayrollRunBranchLine[]
  posProfile                       PosBranchProfile?
  posTerminals                     PosTerminal[]
  posAuditLogs                     AuditLog[]
  catalogVisibility                CatalogItemBranchVisibility[]
  customerPortfolios               CustomerPortfolioAssignment[]
  priceListAssignments             PriceListBranchAssignment[]
  salesCompetitions                PosSalesCompetition[]
  inventoryLocations               InventoryLocation[]
  warehouseRequests                WarehouseRequest[]
  posNotifications                 PosNotification[]
  posTickets                       PosTicket[]
  posAppointments                  PosAppointment[]
  posBusinessDays                  PosBusinessDay[]
  posAttendanceRecords             PosAttendance[]
  posCashExpenses                  PosCashExpense[]
  posSessions                      PosSession[]
  posPositionBranchAssignments     PosPositionBranchAssignment[]
  posCredentialBranchAssignments   PosCredentialBranchAssignment[]
  posMembershipPurchases           PosClientMembership[]
  posMembershipAttendances         PosMembershipAttendance[]
  agendaResources                  AgendaResource[]
  agendaReservations               AgendaReservation[]
  posPortfolioTransfers            PosPortfolioTransferEvent[]
  schedulerPositionAssignments     PositionSchedulerBranchAssignment[]
  schedulerAuthorizations          SchedulerAuthorization[]
  schedulerProfile                 SchedulerBranchProfile?

  @@index([activa])
}

model CategoriaAtencion {
  id            String                 @id @default(cuid())
  nombre        String                 @unique
  activa        Boolean                @default(true)
  subcategorias SubcategoriaAtencion[]
  creadoEn      DateTime               @default(now())
  actualizadoEn DateTime               @updatedAt
}

model SubcategoriaAtencion {
  id            String            @id @default(cuid())
  nombre        String
  activa        Boolean           @default(true)
  categoriaId   String
  categoria     CategoriaAtencion @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  registrosCita RegistroCita[]
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  @@unique([categoriaId, nombre])
  @@index([categoriaId, activa])
}

// ─── Módulo Envelope ──────────────────────────────────────────────────────────

enum MetodoPagoTipo {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

model MetodoPago {
  id            String                  @id @default(cuid())
  nombre        String
  tipo          MetodoPagoTipo
  activo        Boolean                 @default(true)
  detalles      VentaDetalle[]
  creadoEn      DateTime                @default(now())
  actualizadoEn DateTime                @updatedAt
  posPolicy     PosPaymentMethodPolicy?
  posPayments   PosPayment[]
}

model Bank {
  id            String     @id @default(cuid())
  nombre        String     @unique
  activo        Boolean    @default(true)
  empleados     Empleado[]
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
}

model Position {
  id                            String                              @id @default(cuid())
  nombre                        String                              @unique
  activo                        Boolean                             @default(true)
  canManageAccess               Boolean                             @default(false)
  canManagePayrollAccess        Boolean                             @default(false)
  selfDataOnly                  Boolean                             @default(false)
  empleados                     Empleado[]
  screenPermissions             PositionScreenPermission[]
  payrollScreenPermissions      PositionPayrollScreenPermission[]
  posPermissions                PositionPosPermission[]
  posBranchAssignments          PosPositionBranchAssignment[]
  canManageSchedulerAccess      Boolean                             @default(false)
  schedulerSelfProfessionalOnly Boolean                             @default(false)
  schedulerScreenPermissions    PositionSchedulerScreenPermission[]
  schedulerBranchAssignments    PositionSchedulerBranchAssignment[]
  creadoEn                      DateTime                            @default(now())
  actualizadoEn                 DateTime                            @updatedAt
}

model PositionScreenPermission {
  id            String   @id @default(cuid())
  positionId    String
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  screenKey     String
  allowed       Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([positionId, screenKey])
}

model PositionPayrollScreenPermission {
  id            String   @id @default(cuid())
  positionId    String
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  screenKey     String
  allowed       Boolean  @default(true)
  canWrite      Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([positionId, screenKey])
}

model PositionSchedulerScreenPermission {
  id            String   @id @default(cuid())
  positionId    String
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  screenKey     String   @db.VarChar(120)
  canRead       Boolean  @default(false)
  canWrite      Boolean  @default(false)
  canAdmin      Boolean  @default(false)
  canExport     Boolean  @default(false)
  canOverride   Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([positionId, screenKey])
  @@index([screenKey])
}

model PositionSchedulerBranchAssignment {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Sucursal @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creadoEn   DateTime @default(now())

  @@unique([positionId, branchId])
  @@index([branchId])
}

enum ProtectedEmployeeKey {
  KEYSAR_HOME
}

model ProtectedEmployeeIdentity {
  key           ProtectedEmployeeKey @id
  employeeId    String               @unique
  employee      Empleado             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
}

model Empleado {
  id                             String                         @id @default(cuid())
  nombres                        String
  apellidoPaterno                String
  apellidoMaterno                String
  nombreCompleto                 String
  // Campos legacy — se eliminan en Fase 4 tras backfill completo en producción
  banco                          String
  numeroCuenta                   String
  puesto                         String
  sueldo                         Decimal?                       @db.Decimal(10, 2)
  fechaNacimiento                DateTime?
  numeroTelefono                 String?
  // FK a catálogos dinámicos — nullable durante transición
  bankId                         String?
  bank                           Bank?                          @relation(fields: [bankId], references: [id])
  positionId                     String?
  position                       Position?                      @relation(fields: [positionId], references: [id])
  sucursalId                     String?
  sucursal                       Sucursal?                      @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  todasSucursales                Boolean                        @default(false)
  usuario                        Usuario?
  metaIndividual                 Decimal                        @db.Decimal(10, 2)
  activo                         Boolean                        @default(true)
  ventas                         Venta[]
  citasComoVendedor              RegistroCita[]                 @relation("RegistroCitaVendedor")
  citasComoFacialista            RegistroCita[]                 @relation("RegistroCitaFacialista")
  creadoEn                       DateTime                       @default(now())
  actualizadoEn                  DateTime                       @updatedAt
  payrollAssignments             EmployeeCommissionAssignment[]
  payrollMovementAllocations     PayrollMovementAllocation[]
  payrollLoans                   LoanAdvance[]
  payrollRunLines                PayrollRunLine[]
  protectedIdentity              ProtectedEmployeeIdentity?
  posCredentials                 PosCredential[]
  customerPortfolios             CustomerPortfolioAssignment[]
  posTicketSellers               PosTicketSeller[]
  posAppointments                PosAppointment[]
  posLegacyProjections           PosLegacySaleProjection[]
  posAttendances                 PosAttendance[]
  posCashExpenses                PosCashExpense[]
  posMembershipsOriginal         PosClientMembership[]          @relation("PosMembershipOriginalSeller")
  posMembershipsCurrent          PosClientMembership[]          @relation("PosMembershipCurrentSeller")
  posMembershipSellerChangesFrom PosMembershipSellerChange[]    @relation("PosMembershipSellerChangeFrom")
  posMembershipSellerChangesTo   PosMembershipSellerChange[]    @relation("PosMembershipSellerChangeTo")
  posMembershipRankings          PosMembershipSellerRanking[]
  posTicketParticipants          PosTicketParticipant[]
  posPortfolioTransfers          PosPortfolioTransferEvent[]
  schedulerProfessionalProfile   SchedulerProfessionalProfile?

  @@index([sucursalId])
}

// ─── Módulo POS: identidad, terminales y autorización ───────────────────────────────

model PosCredential {
  id                                String                              @id @default(cuid())
  employeeId                        String?                             @unique
  employee                          Empleado?                           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  userId                            String?                             @unique
  user                              Usuario?                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  alias                             String
  aliasNormalized                   String                              @unique
  pinHash                           String
  pinFingerprint                    String                              @unique @db.VarChar(64)
  failedAttempts                    Int                                 @default(0)
  lockedUntil                       DateTime?
  version                           Int                                 @default(1)
  offlineEnabled                    Boolean                             @default(false)
  active                            Boolean                             @default(true)
  creadoEn                          DateTime                            @default(now())
  actualizadoEn                     DateTime                            @updatedAt
  masterProfile                     PosMasterCredential?
  masterAuthorizations              MasterAuthorization[]
  auditLogs                         AuditLog[]
  inventoryBatchesCreated           InventoryAdjustmentBatch[]          @relation("InventoryBatchCreated")
  inventoryBatchesResolved          InventoryAdjustmentBatch[]          @relation("InventoryBatchResolved")
  inventoryCounts                   InventoryCount[]
  inventoryMovements                InventoryMovement[]
  warehouseRequestsCreated          WarehouseRequest[]                  @relation("WarehouseRequestCreated")
  warehouseRequestsCreationApproved WarehouseRequest[]                  @relation("WarehouseRequestCreationApproved")
  warehouseRequestsSendApproved     WarehouseRequest[]                  @relation("WarehouseRequestSendApproved")
  warehouseRequestsReceived         WarehouseRequest[]                  @relation("WarehouseRequestReceived")
  warehouseRequestsCanceled         WarehouseRequest[]                  @relation("WarehouseRequestCanceled")
  warehouseRequestEvents            WarehouseRequestEvent[]
  posNotificationsCreated           PosNotification[]
  posNotificationReads              PosNotificationRead[]
  posNotificationPreferences        PosNotificationPreference[]
  posNotificationOutbox             PosNotificationOutbox[]
  posTicketsCreated                 PosTicket[]
  posPaymentOperations              PosPaymentOperation[]
  posTicketEvents                   PosTicketEvent[]
  posDeliveries                     PosOwedProductDelivery[]
  posAppointments                   PosAppointment[]
  posVoucherIssues                  PosVoucherIssue[]
  posVoucherPrints                  PosVoucherPrintEvent[]
  posBusinessDaysOpened             PosBusinessDay[]                    @relation("PosBusinessDayOpenedBy")
  posBusinessDaysClosed             PosBusinessDay[]                    @relation("PosBusinessDayClosedBy")
  posAttendances                    PosAttendance[]                     @relation("PosAttendanceCredential")
  posAttendancesClosed              PosAttendance[]                     @relation("PosAttendanceClosedBy")
  posExpenseTypesCreated            PosExpenseType[]
  posCashExpensesCreated            PosCashExpense[]                    @relation("PosCashExpenseCreatedBy")
  posCashExpensesVoided             PosCashExpense[]                    @relation("PosCashExpenseVoidedBy")
  posCashMovements                  PosCashMovement[]
  posSyncOperations                 PosSyncOperation[]
  posSessions                       PosSession[]
  posPersonalAuthorizations         PosPersonalAuthorization[]
  posBranchAssignments              PosCredentialBranchAssignment[]
  posMembershipTermsCreated         PosMembershipTerms[]
  posMembershipAttendancesRecorded  PosMembershipAttendance[]
  posMembershipSellerChanges        PosMembershipSellerChange[]
  posMembershipStatusChanges        PosMembershipStatusChange[]
  posMembershipClosures             PosMembershipSalesClosure[]
  agendaSyncEventsResolved          AgendaSyncEvent[]                   @relation("AgendaSyncEventResolvedBy")
  membershipAttendanceCorrections   PosMembershipAttendanceCorrection[]
  posBankChanges                    PosBankChange[]
  posCardNetworkChanges             PosCardNetworkChange[]
  posInstallmentOptionChanges       PosInstallmentOptionChange[]
  posCourtesyProductVersions        PosCourtesyProductVersion[]
  posCourtesyPackageVersions        PosCourtesyPackageVersion[]
  posPortfolioTransfers             PosPortfolioTransferEvent[]

  @@index([active, aliasNormalized])
}

model PosMasterCredential {
  id            String        @id @default(cuid())
  credentialId  String        @unique
  credential    PosCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  active        Boolean       @default(true)
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
}

model PosBranchProfile {
  id            String   @id @default(cuid())
  branchId      String   @unique
  branch        Sucursal @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code          String   @unique @db.VarChar(32)
  address       String?
  timezone      String   @default("America/Mexico_City") @db.VarChar(64)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model PosTerminal {
  id                        String                     @id @default(cuid())
  code                      String                     @unique @db.VarChar(64)
  name                      String                     @db.VarChar(120)
  status                    PosTerminalStatus          @default(ACTIVE)
  branchId                  String
  branch                    Sucursal                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  secretHash                String
  secretFingerprint         String                     @unique @db.VarChar(64)
  lastSeenAt                DateTime?
  registeredByUserId        String?
  creadoEn                  DateTime                   @default(now())
  actualizadoEn             DateTime                   @updatedAt
  auditLogs                 AuditLog[]
  masterAuthorizations      MasterAuthorization[]
  inventoryCounts           InventoryCount[]
  inventoryMovements        InventoryMovement[]
  posTickets                PosTicket[]
  posPaymentOperations      PosPaymentOperation[]
  posDeliveries             PosOwedProductDelivery[]
  posVoucherPrints          PosVoucherPrintEvent[]
  posBusinessDaysOpened     PosBusinessDay[]           @relation("PosBusinessDayOpenedTerminal")
  posBusinessDaysClosed     PosBusinessDay[]           @relation("PosBusinessDayClosedTerminal")
  posAttendances            PosAttendance[]
  posCashExpenses           PosCashExpense[]
  posSyncCursor             PosSyncCursor?
  posSyncOperations         PosSyncOperation[]
  posSessions               PosSession[]
  posPersonalAuthorizations PosPersonalAuthorization[]

  @@index([branchId, status])
}

model PosPermissionNode {
  id             String                  @id
  key            String                  @unique @db.VarChar(80)
  label          String                  @db.VarChar(120)
  description    String?
  parentId       String?
  parent         PosPermissionNode?      @relation("PosPermissionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       PosPermissionNode[]     @relation("PosPermissionTree")
  grantable      Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  active         Boolean                 @default(true)
  version        Int                     @default(1)
  positionGrants PositionPosPermission[]
  creadoEn       DateTime                @default(now())
  actualizadoEn  DateTime                @updatedAt

  @@index([parentId, sortOrder])
}

model PositionPosPermission {
  id               String            @id @default(cuid())
  positionId       String
  position         Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permissionNodeId String
  permissionNode   PosPermissionNode @relation(fields: [permissionNodeId], references: [id], onDelete: Cascade)
  allowed          Boolean           @default(true)
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt

  @@unique([positionId, permissionNodeId])
  @@index([permissionNodeId])
}

model PosPositionBranchAssignment {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Sucursal @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creadoEn   DateTime @default(now())

  @@unique([positionId, branchId])
  @@index([branchId])
}

model PosCredentialBranchAssignment {
  id           String        @id @default(cuid())
  credentialId String
  credential   PosCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Sucursal      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creadoEn     DateTime      @default(now())

  @@unique([credentialId, branchId])
  @@index([branchId])
}

model PosSession {
  id                     String                     @id @default(uuid()) @db.Uuid
  credentialId           String
  credential             PosCredential              @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  terminalId             String
  terminal               PosTerminal                @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  branchId               String
  branch                 Sucursal                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expiresAt              DateTime
  lastSeenAt             DateTime                   @default(now())
  revokedAt              DateTime?
  revokeReason           String?                    @db.VarChar(80)
  creadoEn               DateTime                   @default(now())
  masterAuthorizations   MasterAuthorization[]
  personalAuthorizations PosPersonalAuthorization[]

  @@index([credentialId, revokedAt, expiresAt])
  @@index([terminalId, revokedAt, expiresAt])
}

model PosPersonalAuthorization {
  id           String        @id @default(uuid()) @db.Uuid
  tokenHash    String        @unique @db.VarChar(64)
  purpose      String        @db.VarChar(80)
  scope        Json?
  credentialId String
  credential   PosCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  terminalId   String
  terminal     PosTerminal   @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  sessionId    String        @db.Uuid
  session      PosSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  creadoEn     DateTime      @default(now())

  @@index([credentialId, purpose, expiresAt])
  @@index([sessionId, expiresAt])
}

model MasterAuthorization {
  id                       String                              @id @default(cuid())
  tokenHash                String                              @unique @db.VarChar(64)
  purpose                  String                              @db.VarChar(80)
  entityType               String?                             @db.VarChar(80)
  entityId                 String?
  scope                    Json?
  actorCredentialId        String
  actorCredential          PosCredential                       @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  terminalId               String
  terminal                 PosTerminal                         @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  expiresAt                DateTime
  usedAt                   DateTime?
  creadoEn                 DateTime                            @default(now())
  sessionId                String?                             @db.Uuid
  session                  PosSession?                         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  businessDayOpening       PosBusinessDay?                     @relation("PosBusinessDayOpeningAuthorization")
  businessDayClosing       PosBusinessDay?                     @relation("PosBusinessDayClosingAuthorization")
  businessDayCloseApproval PosBusinessDay?                     @relation("PosBusinessDayCloseApproval")
  cashExpensesVoided       PosCashExpense[]
  cashMovements            PosCashMovement[]
  membershipCorrections    PosMembershipAttendanceCorrection[]

  @@index([actorCredentialId, purpose, expiresAt])
  @@index([terminalId, expiresAt])
}

model AuditLog {
  id                String         @id @default(cuid())
  action            String         @db.VarChar(120)
  outcome           String         @db.VarChar(32)
  actorCredentialId String?
  actorCredential   PosCredential? @relation(fields: [actorCredentialId], references: [id], onDelete: SetNull)
  terminalId        String?
  terminal          PosTerminal?   @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  branchId          String?
  branch            Sucursal?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  targetType        String?        @db.VarChar(80)
  targetId          String?
  ipAddress         String?        @db.VarChar(64)
  userAgent         String?        @db.VarChar(512)
  metadata          Json?
  application       String         @default("POS") @db.VarChar(32)
  actorUserId       String?
  actorUser         Usuario?       @relation("SchedulerAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  creadoEn          DateTime       @default(now())

  @@index([action, creadoEn])
  @@index([actorCredentialId, creadoEn])
  @@index([terminalId, creadoEn])
  @@index([application, actorUserId, creadoEn])
}

model SchedulerSecondaryCredential {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash     String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  version        Int       @default(1)
  active         Boolean   @default(true)
  lastUsedAt     DateTime?
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt
}

model SchedulerAuthorization {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  purpose     String    @db.VarChar(80)
  screenKey   String    @db.VarChar(120)
  scope       Json?
  actorUserId String
  actorUser   Usuario   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  branchId    String?
  branch      Sucursal? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  creadoEn    DateTime  @default(now())

  @@index([actorUserId, purpose, expiresAt])
  @@index([branchId, expiresAt])
}

// ─── Scheduler: catálogos operativos y disponibilidad base ──────────────────

enum SchedulerWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SchedulerAvailabilityRuleKind {
  WORKING
  BREAK
}

enum SchedulerAvailabilityExceptionKind {
  AVAILABLE
  UNAVAILABLE
}

enum SchedulerServiceMode {
  INDIVIDUAL
  CLASS
}

enum SchedulerResourceKind {
  ROOM
  EQUIPMENT
  STATION
  OTHER
}

model SchedulerCommerce {
  id             String                       @id @default(cuid())
  name           String                       @db.VarChar(160)
  normalizedName String                       @unique @db.VarChar(180)
  active         Boolean                      @default(true)
  effectiveFrom  DateTime                     @default(now())
  effectiveTo    DateTime?
  deactivatedAt  DateTime?
  branchProfiles SchedulerBranchProfile[]
  specialties    SchedulerSpecialty[]
  groups         SchedulerProfessionalGroup[]
  creadoEn       DateTime                     @default(now())
  actualizadoEn  DateTime                     @updatedAt

  @@index([active, effectiveFrom, effectiveTo])
}

model SchedulerBranchProfile {
  id                      String                                   @id @default(cuid())
  branchId                String                                   @unique
  branch                  Sucursal                                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  commerceId              String
  commerce                SchedulerCommerce                        @relation(fields: [commerceId], references: [id], onDelete: Restrict)
  timezone                String                                   @default("America/Mexico_City") @db.VarChar(80)
  bookingEnabled          Boolean                                  @default(false)
  active                  Boolean                                  @default(true)
  effectiveFrom           DateTime                                 @default(now())
  effectiveTo             DateTime?
  deactivatedAt           DateTime?
  version                 Int                                      @default(1)
  professionalAssignments SchedulerProfessionalBranchAssignment[]
  serviceAssignments      SchedulerServiceBranchAssignment[]
  professionalServices    SchedulerProfessionalServiceAssignment[]
  resources               SchedulerResource[]
  groups                  SchedulerProfessionalGroup[]
  availabilityRules       SchedulerAvailabilityRule[]
  availabilityExceptions  SchedulerAvailabilityException[]
  creadoEn                DateTime                                 @default(now())
  actualizadoEn           DateTime                                 @updatedAt

  @@index([commerceId, active])
  @@index([bookingEnabled, active])
}

model SchedulerProfessionalProfile {
  id                     String                                   @id @default(cuid())
  employeeId             String                                   @unique
  employee               Empleado                                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  biography              String?
  acceptsOnline          Boolean                                  @default(false)
  active                 Boolean                                  @default(true)
  effectiveFrom          DateTime                                 @default(now())
  effectiveTo            DateTime?
  deactivatedAt          DateTime?
  version                Int                                      @default(1)
  branchAssignments      SchedulerProfessionalBranchAssignment[]
  serviceAssignments     SchedulerProfessionalServiceAssignment[]
  specialties            SchedulerProfessionalSpecialty[]
  groupMemberships       SchedulerProfessionalGroupMember[]
  availabilityRules      SchedulerAvailabilityRule[]
  availabilityExceptions SchedulerAvailabilityException[]
