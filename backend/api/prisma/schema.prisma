  membership             PosClientMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  fromSellerId           String?
  fromSeller             Empleado?           @relation("PosMembershipSellerChangeFrom", fields: [fromSellerId], references: [id], onDelete: Restrict)
  fromSellerNameSnapshot String              @db.VarChar(240)
  toSellerId             String
  toSeller               Empleado            @relation("PosMembershipSellerChangeTo", fields: [toSellerId], references: [id], onDelete: Restrict)
  toSellerNameSnapshot   String              @db.VarChar(240)
  reason                 String              @db.VarChar(1000)
  actorCredentialId      String
  actorCredential        PosCredential       @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  cambiadoEn             DateTime            @default(now())

  @@index([membershipId, cambiadoEn])
  @@index([toSellerId, cambiadoEn])
}

model PosMembershipStatusChange {
  id                String              @id @default(uuid()) @db.Uuid
  membershipId      String              @db.Uuid
  membership        PosClientMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  fromStatus        PosMembershipStatus
  toStatus          PosMembershipStatus
  reason            String              @db.VarChar(1000)
  actorCredentialId String
  actorCredential   PosCredential       @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  sourceType        String?             @db.VarChar(80)
  sourceId          String?
  cambiadoEn        DateTime            @default(now())

  @@index([membershipId, cambiadoEn])
}

model PosMembershipSalesClosure {
  id                    String                       @id @default(uuid()) @db.Uuid
  month                 DateTime                     @db.Date
  scopeHash             String                       @db.VarChar(64)
  branchIds             Json
  version               Int
  membershipCount       Int
  totalAmount           Decimal                      @db.Decimal(14, 2)
  createdByCredentialId String
  createdByCredential   PosCredential                @relation(fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  rankings              PosMembershipSellerRanking[]
  creadoEn              DateTime                     @default(now())

  @@unique([month, scopeHash, version])
  @@index([month, creadoEn])
}

model PosMembershipSellerRanking {
  id                 String                    @id @default(cuid())
  closureId          String                    @db.Uuid
  closure            PosMembershipSalesClosure @relation(fields: [closureId], references: [id], onDelete: Restrict)
  rank               Int
  originalSellerId   String?
  originalSeller     Empleado?                 @relation(fields: [originalSellerId], references: [id], onDelete: Restrict)
  sellerNameSnapshot String                    @db.VarChar(240)
  quantity           Int
  amount             Decimal                   @db.Decimal(14, 2)

  @@unique([closureId, rank])
  @@index([originalSellerId, closureId])
}

model PosLegacySaleProjection {
  id          String              @id @default(cuid())
  operationId String              @db.Uuid
  operation   PosPaymentOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    Empleado            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  ventaId     String              @unique
  venta       Venta               @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  amount      Decimal             @db.Decimal(14, 2)
  creadoEn    DateTime            @default(now())

  @@unique([operationId, employeeId])
  @@index([operationId])
}

model PosVoucherIssue {
  id                   String                 @id @default(uuid()) @db.Uuid
  folio                String                 @unique @db.VarChar(80)
  templateId           String
  template             PosVoucherTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  ticketId             String                 @db.Uuid
  ticket               PosTicket              @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  customerId           String?
  customer             Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  templateNameSnapshot String                 @db.VarChar(160)
  kindSnapshot         PosVoucherKind
  valueSnapshot        Decimal                @db.Decimal(14, 2)
  messageSnapshot      String                 @db.VarChar(1000)
  status               PosVoucherIssueStatus  @default(ISSUED)
  issuedByCredentialId String
  issuedByCredential   PosCredential          @relation(fields: [issuedByCredentialId], references: [id], onDelete: Restrict)
  redeemedAt           DateTime?
  printEvents          PosVoucherPrintEvent[]
  creadoEn             DateTime               @default(now())

  @@unique([ticketId, templateId])
  @@index([customerId, status])
}

model PosVoucherPrintEvent {
  id                String          @id @default(uuid()) @db.Uuid
  issueId           String          @db.Uuid
  issue             PosVoucherIssue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  copyNumber        Int
  actorCredentialId String
  actorCredential   PosCredential   @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  terminalId        String
  terminal          PosTerminal     @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  creadoEn          DateTime        @default(now())

  @@unique([issueId, copyNumber])
  @@index([issueId, creadoEn])
}

// ─── Módulo POS: jornada, asistencia y caja ──────────────────────────────

enum PosBusinessDayStatus {
  OPEN
  CLOSED
}

enum PosAttendanceStatus {
  OPEN
  CLOSED
}

enum PosAttendanceCloseReason {
  MANUAL
  CLOSE_DAY
}

enum PosCashExpenseStatus {
  ACTIVE
  VOIDED
}

enum PosCashMovementKind {
  EXPENSE
  CORRECTION
  VOID
}

model PosBusinessDay {
  id                     String               @id @default(uuid()) @db.Uuid
  branchId               String
  branch                 Sucursal             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  businessDate           DateTime             @db.Date
  status                 PosBusinessDayStatus @default(OPEN)
  openingCountId         String?              @unique
  openingCount           InventoryCount?      @relation("PosBusinessDayOpeningCount", fields: [openingCountId], references: [id], onDelete: Restrict)
  openingSkipped         Boolean              @default(false)
  openingAuthorizationId String?              @unique
  openingAuthorization   MasterAuthorization? @relation("PosBusinessDayOpeningAuthorization", fields: [openingAuthorizationId], references: [id], onDelete: Restrict)
  openedByCredentialId   String
  openedByCredential     PosCredential        @relation("PosBusinessDayOpenedBy", fields: [openedByCredentialId], references: [id], onDelete: Restrict)
  openedTerminalId       String
  openedTerminal         PosTerminal          @relation("PosBusinessDayOpenedTerminal", fields: [openedTerminalId], references: [id], onDelete: Restrict)
  openedAt               DateTime             @default(now())
  closingCountId         String?              @unique
  closingCount           InventoryCount?      @relation("PosBusinessDayClosingCount", fields: [closingCountId], references: [id], onDelete: Restrict)
  closingSkipped         Boolean              @default(false)
  closingAuthorizationId String?              @unique
  closingAuthorization   MasterAuthorization? @relation("PosBusinessDayClosingAuthorization", fields: [closingAuthorizationId], references: [id], onDelete: Restrict)
  closeAuthorizationId   String?              @unique
  closeAuthorization     MasterAuthorization? @relation("PosBusinessDayCloseApproval", fields: [closeAuthorizationId], references: [id], onDelete: Restrict)
  closedByCredentialId   String?
  closedByCredential     PosCredential?       @relation("PosBusinessDayClosedBy", fields: [closedByCredentialId], references: [id], onDelete: Restrict)
  closedTerminalId       String?
  closedTerminal         PosTerminal?         @relation("PosBusinessDayClosedTerminal", fields: [closedTerminalId], references: [id], onDelete: Restrict)
  closedAt               DateTime?
  closeSummary           Json?
  attendances            PosAttendance[]
  cashExpenses           PosCashExpense[]
  creadoEn               DateTime             @default(now())
  actualizadoEn          DateTime             @updatedAt

  @@unique([branchId, businessDate])
  @@index([status, businessDate])
}

model PosAttendance {
  id                   String                    @id @default(uuid()) @db.Uuid
  businessDayId        String                    @db.Uuid
  businessDay          PosBusinessDay            @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  employeeId           String
  employee             Empleado                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId             String
  branch               Sucursal                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  businessDate         DateTime                  @db.Date
  credentialId         String
  credential           PosCredential             @relation("PosAttendanceCredential", fields: [credentialId], references: [id], onDelete: Restrict)
  terminalId           String
  terminal             PosTerminal               @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  clockInAt            DateTime                  @default(now())
  clockOutAt           DateTime?
  status               PosAttendanceStatus       @default(OPEN)
  closeReason          PosAttendanceCloseReason?
  closedByCredentialId String?
  closedByCredential   PosCredential?            @relation("PosAttendanceClosedBy", fields: [closedByCredentialId], references: [id], onDelete: Restrict)
  creadoEn             DateTime                  @default(now())

  @@index([branchId, businessDate, status])
  @@index([employeeId, businessDate])
}

model PosExpenseType {
  id                    String           @id @default(cuid())
  name                  String           @unique @db.VarChar(160)
  active                Boolean          @default(true)
  deletedAt             DateTime?
  createdByCredentialId String
  createdByCredential   PosCredential    @relation(fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  expenses              PosCashExpense[]
  creadoEn              DateTime         @default(now())
  actualizadoEn         DateTime         @updatedAt

  @@index([active, name])
}

model PosCashExpense {
  id                    String               @id @default(uuid()) @db.Uuid
  folio                 String               @unique @db.VarChar(80)
  businessDayId         String               @db.Uuid
  businessDay           PosBusinessDay       @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  businessDate          DateTime             @db.Date
  branchId              String
  branch                Sucursal             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  terminalId            String
  terminal              PosTerminal          @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  employeeId            String?
  employee              Empleado?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeNameSnapshot  String               @db.VarChar(240)
  expenseTypeId         String
  expenseType           PosExpenseType       @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  expenseTypeSnapshot   String               @db.VarChar(160)
  amount                Decimal              @db.Decimal(14, 2)
  concept               String               @db.VarChar(500)
  comment               String?              @db.VarChar(1000)
  status                PosCashExpenseStatus @default(ACTIVE)
  correctsExpenseId     String?              @db.Uuid
  correctsExpense       PosCashExpense?      @relation("PosCashExpenseCorrections", fields: [correctsExpenseId], references: [id], onDelete: Restrict)
  corrections           PosCashExpense[]     @relation("PosCashExpenseCorrections")
  createdByCredentialId String
  createdByCredential   PosCredential        @relation("PosCashExpenseCreatedBy", fields: [createdByCredentialId], references: [id], onDelete: Restrict)
  voidedAt              DateTime?
  voidedByCredentialId  String?
  voidedByCredential    PosCredential?       @relation("PosCashExpenseVoidedBy", fields: [voidedByCredentialId], references: [id], onDelete: Restrict)
  voidAuthorizationId   String?
  voidAuthorization     MasterAuthorization? @relation(fields: [voidAuthorizationId], references: [id], onDelete: Restrict)
  movements             PosCashMovement[]
  creadoEn              DateTime             @default(now())

  @@index([branchId, businessDate, creadoEn])
  @@index([employeeId, businessDate])
  @@index([status, businessDate])
}

model PosCashMovement {
  id                String               @id @default(uuid()) @db.Uuid
  expenseId         String               @db.Uuid
  expense           PosCashExpense       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  kind              PosCashMovementKind
  amount            Decimal              @db.Decimal(14, 2)
  businessDate      DateTime             @db.Date
  actorCredentialId String
  actorCredential   PosCredential        @relation(fields: [actorCredentialId], references: [id], onDelete: Restrict)
  authorizationId   String?
  authorization     MasterAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  reason            String?              @db.VarChar(1000)
  snapshot          Json
  creadoEn          DateTime             @default(now())

  @@index([businessDate, creadoEn])
  @@index([expenseId, creadoEn])
}

// ─── Módulo POS: operación offline y reconciliación ───────────────────

enum PosSyncOperationStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
  CONFLICT
}

enum PosOfflineOperationKind {
  BUSINESS_DAY_OPEN
  INVENTORY_COUNT
  TICKET_CREATE
  LAYAWAY_PAYMENT
  AGENDA_MEMBERSHIP_RESERVATION
  MEMBERSHIP_ATTENDANCE
  VOUCHER_ISSUE
  VOUCHER_PRINT
  BUSINESS_DAY_CLOSING_COUNT
  BUSINESS_DAY_CLOSE
}

model PosSyncCursor {
  id            String      @id @default(cuid())
  terminalId    String      @unique
  terminal      PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  lastSequence  BigInt      @default(0)
  actualizadoEn DateTime    @updatedAt
}

model PosSyncOperation {
  id                String                  @id @default(cuid())
  clientOperationId String                  @unique @db.Uuid
  terminalId        String
  terminal          PosTerminal             @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  terminalSequence  BigInt
  credentialId      String
  credential        PosCredential           @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  kind              PosOfflineOperationKind
  idempotencyKey    String                  @unique @db.Uuid
  entityId          String?
  dependencyIds     Json                    @default("[]")
  payloadHash       String                  @db.VarChar(64)
  status            PosSyncOperationStatus
  serverEntityId    String?
  response          Json?
  errorCode         String?                 @db.VarChar(80)
  errorMessage      String?                 @db.VarChar(1000)
  clientCreatedAt   DateTime
  syncedAt          DateTime?
  creadoEn          DateTime                @default(now())
  actualizadoEn     DateTime                @updatedAt

  @@unique([terminalId, terminalSequence])
  @@index([terminalId, status, terminalSequence])
  @@index([credentialId, creadoEn])
}

enum TipoCompraCita {
  PAGO_NETO
  COMPRA_CON_APARTADO
  PAGO_DE_APARTADO
}

enum EstatusCita {
  ATENDIDA
  NO_LLEGO
  CANCELADA
}

// Registro operativo de una cita atendida; más adelante podrá vincularse con Scheduler.
model RegistroCita {
  id              String               @id @default(cuid())
  fecha           DateTime
  hora            String?              @db.VarChar(5)
  subcategoriaId  String
  subcategoria    SubcategoriaAtencion @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  estatus         EstatusCita          @default(ATENDIDA)
  nombreCliente   String
  sucursalId      String
  sucursal        Sucursal             @relation(fields: [sucursalId], references: [id])
  vendedorId      String
  vendedor        Empleado             @relation("RegistroCitaVendedor", fields: [vendedorId], references: [id])
  facialistaId    String
  facialista      Empleado             @relation("RegistroCitaFacialista", fields: [facialistaId], references: [id])
  tipoCompra      TipoCompraCita?
  montoCompra     Decimal              @default(0) @db.Decimal(10, 2)
  montoApartado   Decimal              @default(0) @db.Decimal(10, 2)
  bonoSalidaTarde Boolean              @default(false)
  bonoComida      Boolean              @default(false)
  creadoPorId     String
  creadoPor       Usuario              @relation(fields: [creadoPorId], references: [id])
  creadoEn        DateTime             @default(now())
  actualizadoEn   DateTime             @updatedAt

  @@index([fecha])
  @@index([estatus, fecha])
  @@index([sucursalId, fecha])
  @@index([facialistaId, fecha])
  @@index([vendedorId, fecha])
  @@index([creadoPorId])
  @@index([subcategoriaId])
}

// Agrupa todas las ventas de un vendedor en un día
model Venta {
  id            String                   @id @default(cuid())
  fecha         DateTime
  notas         String?
  // Vincula registros guardados juntos (mismo voucher multi-vendedor); nullable = venta individual
  sesionId      String?
  sucursalId    String
  sucursal      Sucursal                 @relation(fields: [sucursalId], references: [id])
  vendedorId    String
  vendedor      Empleado                 @relation(fields: [vendedorId], references: [id])
  detalles      VentaDetalle[]
  creadoEn      DateTime                 @default(now())
  actualizadoEn DateTime                 @updatedAt
  posProjection PosLegacySaleProjection?

  @@index([fecha])
  @@index([sucursalId, fecha])
  @@index([vendedorId, fecha])
  @@index([sesionId])
}

// Cada fila = una venta individual con monto y método de pago
model VentaDetalle {
  id            String     @id @default(cuid())
  cantidad      Decimal    @db.Decimal(10, 2)
  ventaId       String
  venta         Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodoPagoId  String
  metodoPago    MetodoPago @relation(fields: [metodoPagoId], references: [id])
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@index([ventaId])
  @@index([metodoPagoId])
}

// ─── Módulo Payroll ───────────────────────────────────────────────────────────────────

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELED
}

enum PayrollCalculationMode {
  WITH_VAT
  WITHOUT_VAT
}

enum PayrollMovementKind {
  BONUS
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  FINE
  PER_DIEM
  SUPPLIES
}

enum PayrollMovementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollMovementPayrollType {
  FIXED_SALARY
  SPECIALIST
  COMMISSION
  MANAGEMENT_COMMISSION
}

enum PayrollCatalogKind {
  BONUS
  FINE
  PER_DIEM
}

enum PayrollExpenseKind {
  FIXED
  VARIABLE
}

enum PayrollExpenseFrequency {
  ONE_TIME
  BIWEEKLY
  MONTHLY
}

enum LoanAdvanceKind {
  LOAN
  PAYROLL_ADVANCE
}

enum LoanAdvanceStatus {
  PENDING
  PAID
  LOST
  CANCELED
}

enum LoanInstallmentStatus {
  SCHEDULED
  RESERVED
  PAID
  CANCELED
}

enum PayrollReceiptStatus {
  GENERATED
  SENT
  CONFIRMED
}

model PayrollCatalogItem {
  id            String             @id @default(cuid())
  kind          PayrollCatalogKind
  name          String
  defaultAmount Decimal            @db.Decimal(14, 2)
  notes         String?
  active        Boolean            @default(true)
  createdById   String
  createdBy     Usuario            @relation("PayrollCatalogItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  movements     PayrollMovement[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([kind, name])
  @@index([kind, active])
}

model CommissionScheme {
  id          String                         @id @default(cuid())
  name        String                         @unique
  active      Boolean                        @default(true)
  versions    CommissionSchemeVersion[]
  assignments EmployeeCommissionAssignment[]
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
}

model CommissionSchemeVersion {
  id            String                 @id @default(cuid())
  schemeId      String
  scheme        CommissionScheme       @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  version       Int
  effectiveFrom DateTime               @db.Date
  createdById   String
  createdBy     Usuario                @relation("CommissionSchemeVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tiers         CommissionSchemeTier[]
  createdAt     DateTime               @default(now())

  @@unique([schemeId, version])
  @@unique([schemeId, effectiveFrom])
  @@index([effectiveFrom])
}

model CommissionSchemeTier {
  id         String                  @id @default(cuid())
  versionId  String
  version    CommissionSchemeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromAmount Decimal                 @db.Decimal(14, 2)
  toAmount   Decimal?                @db.Decimal(14, 2)
  rate       Decimal                 @db.Decimal(8, 6)
  sortOrder  Int

  @@unique([versionId, sortOrder])
}

model EmployeeCommissionAssignment {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Empleado         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  schemeId      String
  scheme        CommissionScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime         @db.Date
  effectiveTo   DateTime?        @db.Date
  createdById   String
  createdBy     Usuario          @relation("EmployeeCommissionAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([schemeId])
}

model PayrollRun {
  id              String                   @id @default(cuid())
  periodStart     DateTime                 @db.Date
  periodEnd       DateTime                 @db.Date
  payDate         DateTime                 @db.Date
  mode            PayrollCalculationMode
  vatRate         Decimal                  @default(0.16) @db.Decimal(8, 6)
  status          PayrollRunStatus         @default(DRAFT)
  salesWithVat    Decimal                  @default(0) @db.Decimal(14, 2)
  salesWithoutVat Decimal                  @default(0) @db.Decimal(14, 2)
  expenseTotal    Decimal                  @default(0) @db.Decimal(14, 2)
  payrollTotal    Decimal                  @default(0) @db.Decimal(14, 2)
  generalBalance  Decimal                  @default(0) @db.Decimal(14, 2)
  warnings        Json?
  createdById     String
  createdBy       Usuario                  @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      Usuario?                 @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidById        String?
  paidBy          Usuario?                 @relation("PayrollRunPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?
  paidAt          DateTime?
  canceledAt      DateTime?
  lines           PayrollRunLine[]
  movements       PayrollMovement[]
  expenses        PayrollExpense[]
  installments    LoanAdvanceInstallment[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([periodStart, periodEnd])
  @@index([status, periodStart])
}

model PayrollRunLine {
  id                 String                 @id @default(cuid())
  payrollRunId       String
  payrollRun         PayrollRun             @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Empleado               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName       String
  positionName       String?
  bankName           String?
  accountNumber      String?
  phoneNumber        String?
  schemeName         String?
  schemeVersion      Int?
  individualRate     Decimal?               @db.Decimal(8, 6)
  monthlySalary      Decimal                @default(0) @db.Decimal(14, 2)
  salaryPayment      Decimal                @default(0) @db.Decimal(14, 2)
  salesWithVat       Decimal                @default(0) @db.Decimal(14, 2)
  salesWithoutVat    Decimal                @default(0) @db.Decimal(14, 2)
  commission         Decimal                @default(0) @db.Decimal(14, 2)
  bonus              Decimal                @default(0) @db.Decimal(14, 2)
  fine               Decimal                @default(0) @db.Decimal(14, 2)
  adjustmentPositive Decimal                @default(0) @db.Decimal(14, 2)
  adjustmentNegative Decimal                @default(0) @db.Decimal(14, 2)
  perDiem            Decimal                @default(0) @db.Decimal(14, 2)
  supplies           Decimal                @default(0) @db.Decimal(14, 2)
  loanPayment        Decimal                @default(0) @db.Decimal(14, 2)
  totalPayment       Decimal                @default(0) @db.Decimal(14, 2)
  warnings           Json?
  branchLines        PayrollRunBranchLine[]
  receipt            PayrollReceipt?
  createdAt          DateTime               @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollRunBranchLine {
  id                 String         @id @default(cuid())
  payrollRunLineId   String
  payrollRunLine     PayrollRunLine @relation(fields: [payrollRunLineId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Sucursal?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchName         String
  salesWithVat       Decimal        @default(0) @db.Decimal(14, 2)
  salesWithoutVat    Decimal        @default(0) @db.Decimal(14, 2)
  commission         Decimal        @default(0) @db.Decimal(14, 2)
  bonus              Decimal        @default(0) @db.Decimal(14, 2)
  fine               Decimal        @default(0) @db.Decimal(14, 2)
  salaryPayment      Decimal        @default(0) @db.Decimal(14, 2)
  adjustmentPositive Decimal        @default(0) @db.Decimal(14, 2)
  adjustmentNegative Decimal        @default(0) @db.Decimal(14, 2)
  perDiem            Decimal        @default(0) @db.Decimal(14, 2)
  supplies           Decimal        @default(0) @db.Decimal(14, 2)
  loanPayment        Decimal        @default(0) @db.Decimal(14, 2)
  totalCost          Decimal        @default(0) @db.Decimal(14, 2)

  @@unique([payrollRunLineId, branchName])
  @@index([branchId])
}

model PayrollMovement {
  id            String                      @id @default(cuid())
  date          DateTime                    @db.Date
  kind          PayrollMovementKind
  payrollType   PayrollMovementPayrollType?
  catalogItemId String?
  catalogItem   PayrollCatalogItem?         @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  concept       String
  totalAmount   Decimal                     @db.Decimal(14, 2)
  status        PayrollMovementStatus       @default(PENDING)
  notes         String?
  payrollRunId  String?
  payrollRun    PayrollRun?                 @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     Usuario                     @relation("PayrollMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    Usuario?                    @relation("PayrollMovementReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt    DateTime?
  allocations   PayrollMovementAllocation[]
  attachments   PayrollAttachment[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([date, status])
  @@index([payrollRunId])
}

model PayrollMovementAllocation {
  id             String          @id @default(cuid())
  movementId     String
  movement       PayrollMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Empleado        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Sucursal?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount         Decimal         @db.Decimal(14, 2)
  commissionable Boolean         @default(true)

  @@unique([movementId, employeeId])
  @@index([employeeId])
  @@index([branchId])
}

model PayrollAttachment {
  id          String          @id @default(cuid())
  movementId  String
  movement    PayrollMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  storagePath String          @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime        @default(now())

  @@index([movementId])
}

model PayrollExpense {
  id                  String                           @id @default(cuid())
  date                DateTime                         @db.Date
  kind                PayrollExpenseKind
  concept             String
  category            String
  categoryId          String?
  categoryRecord      PayrollExpenseCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branchId            String?
  branch              Sucursal?                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  costCenter          String
  amount              Decimal                          @db.Decimal(14, 2)
  frequency           PayrollExpenseFrequency
  notes               String?
  payrollRunId        String?
  payrollRun          PayrollRun?                      @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  recurrenceId        String?
  recurrence          PayrollExpenseRecurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  recurrenceVersionId String?
  recurrenceVersion   PayrollExpenseRecurrenceVersion? @relation(fields: [recurrenceVersionId], references: [id], onDelete: Restrict)
  generated           Boolean                          @default(false)
  createdById         String
  createdBy           Usuario                          @relation("PayrollExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedAt           DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@unique([recurrenceVersionId, date])
  @@index([date, deletedAt])
  @@index([payrollRunId])
  @@index([branchId])
  @@index([categoryId])
  @@index([recurrenceId, date])
}

model PayrollExpenseCategory {
  id                 String                            @id @default(cuid())
  name               String                            @unique
  active             Boolean                           @default(true)
  createdById        String
  createdBy          Usuario                           @relation("PayrollExpenseCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses           PayrollExpense[]
  recurrenceVersions PayrollExpenseRecurrenceVersion[]
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@index([active, name])
}

model PayrollExpenseRecurrence {
  id          String                            @id @default(cuid())
  active      Boolean                           @default(true)
  endedAt     DateTime?                         @db.Date
  createdById String
  createdBy   Usuario                           @relation("PayrollExpenseRecurrenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions    PayrollExpenseRecurrenceVersion[]
  expenses    PayrollExpense[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@index([active])
}

model PayrollExpenseRecurrenceVersion {
  id             String                   @id @default(cuid())
  recurrenceId   String
  recurrence     PayrollExpenseRecurrence @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  anchorDate     DateTime                 @db.Date
  effectiveFrom  DateTime                 @db.Date
  effectiveTo    DateTime?                @db.Date
  kind           PayrollExpenseKind
  concept        String
  category       String
  categoryId     String?
  categoryRecord PayrollExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Sucursal?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  costCenter     String
  amount         Decimal                  @db.Decimal(14, 2)
  frequency      PayrollExpenseFrequency
  notes          String?
  createdById    String
  createdBy      Usuario                  @relation("PayrollExpenseRecurrenceVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses       PayrollExpense[]
  createdAt      DateTime                 @default(now())

  @@unique([recurrenceId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@index([branchId])
  @@index([categoryId])
}

model LoanAdvance {
  id                String                   @id @default(cuid())
  requestedAt       DateTime                 @db.Date
  employeeId        String
  employee          Empleado                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind              LoanAdvanceKind
  requestedAmount   Decimal                  @db.Decimal(14, 2)
  installmentCount  Int
  installmentAmount Decimal                  @db.Decimal(14, 2)
  paidAmount        Decimal                  @default(0) @db.Decimal(14, 2)
  balance           Decimal                  @db.Decimal(14, 2)
  status            LoanAdvanceStatus        @default(PENDING)
  notes             String?
  createdById       String
  createdBy         Usuario                  @relation("LoanAdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  installments      LoanAdvanceInstallment[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([employeeId, status])
  @@index([requestedAt])
}

model LoanAdvanceInstallment {
  id            String                @id @default(cuid())
  loanAdvanceId String
  loanAdvance   LoanAdvance           @relation(fields: [loanAdvanceId], references: [id], onDelete: Cascade)
  sequence      Int
  periodStart   DateTime              @db.Date
  periodEnd     DateTime              @db.Date
  amount        Decimal               @db.Decimal(14, 2)
  status        LoanInstallmentStatus @default(SCHEDULED)
  payrollRunId  String?
  payrollRun    PayrollRun?           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  paidAt        DateTime?

  @@unique([loanAdvanceId, sequence])
  @@index([periodStart, periodEnd, status])
  @@index([payrollRunId])
}

model PayrollReceipt {
  id               String               @id @default(cuid())
  payrollRunLineId String               @unique
  payrollRunLine   PayrollRunLine       @relation(fields: [payrollRunLineId], references: [id], onDelete: Restrict)
  status           PayrollReceiptStatus @default(GENERATED)
  sentAt           DateTime?
  sentById         String?
  sentBy           Usuario?             @relation("PayrollReceiptSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      Usuario?             @relation("PayrollReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

model PayrollAuditEvent {
  id         String   @id @default(cuid())
  userId     String
  user       Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}
