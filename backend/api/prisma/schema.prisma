}

model SchedulerServiceBranchAssignment {
  id               String                  @id @default(cuid())
  serviceProfileId String
  serviceProfile   SchedulerServiceProfile @relation(fields: [serviceProfileId], references: [id], onDelete: Restrict)
  branchProfileId  String
