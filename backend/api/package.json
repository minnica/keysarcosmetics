{
  "name": "@cosmetics/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:workspace-deps": "pnpm --filter @cosmetics/api^... --if-present run build",
    "predev": "pnpm run build:workspace-deps",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "checks:prepare": "pnpm run build:workspace-deps && prisma generate",
    "pretype-check": "pnpm run checks:prepare",
    "type-check": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "pretest:unit": "pnpm run checks:prepare",
    "test:unit": "vitest run --exclude \"src/**/*.integration.test.ts\"",
    "pretest:integration": "pnpm run checks:prepare",
    "test:integration": "vitest run src/app.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:schemas": "node scripts/check-prisma-schema-sync.mjs"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@cosmetics/types": "workspace:*",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
