# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/cosmetics_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia_esto_en_produccion"
JWT_EXPIRES_IN="7d"

# ─── Seguridad POS (valores distintos, aleatorios y de 32+ caracteres) ──────
POS_JWT_SECRET="cambia_esto_por_un_secreto_pos_independiente"
POS_JWT_EXPIRES_IN="8h"
POS_PIN_PEPPER="cambia_esto_por_un_pepper_pos_independiente"

# ─── Backend ─────────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005"

# ─── Apps (URLs base para el api-client) ─────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
